<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>CACI O6 Assembly – Church Management</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'DM Sans',sans-serif;
  background:#020c1b;
  color:#cfe4ff;
  min-height:100vh;
  background-image:
    radial-gradient(ellipse 80% 55% at 15% 0%,   rgba(0,120,255,.22) 0%,transparent 55%),
    radial-gradient(ellipse 60% 50% at 85% 5%,   rgba(0,200,255,.14) 0%,transparent 50%),
    radial-gradient(ellipse 50% 40% at 50% 100%, rgba(0,80,200,.18)  0%,transparent 55%),
    radial-gradient(ellipse 40% 35% at 80% 80%,  rgba(0,240,255,.08) 0%,transparent 45%);
}
h1,h2,h3,h4{font-family:'Playfair Display',serif}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-thumb{background:linear-gradient(180deg,rgba(0,160,255,.6),rgba(0,220,255,.3));border-radius:3px}
input[type=date]::-webkit-calendar-picker-indicator{filter:invert(.4) sepia(1) saturate(3) hue-rotate(10deg)}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes toastIn{from{transform:translateX(60px);opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}

/* ── APP SHELL ── */
#app-shell{display:flex;min-height:100vh}
#sidebar{width:230px;flex-shrink:0;background:linear-gradient(180deg,#020c1b 0%,#021428 55%,#031020 100%);border-right:1px solid rgba(0,160,255,.18);display:flex;flex-direction:column;position:fixed;top:0;left:0;height:100vh;z-index:200;transition:transform .25s ease}
#sidebar.collapsed{transform:translateX(-230px)}
#main-content{flex:1;margin-left:230px;transition:margin-left .25s ease;display:flex;flex-direction:column;min-height:100vh}
#main-content.full{margin-left:0}
#topbar{height:58px;background:rgba(2,12,27,.9);backdrop-filter:blur(20px);border-bottom:1px solid rgba(0,160,255,.15);display:flex;align-items:center;padding:0 22px;gap:12px;position:sticky;top:0;z-index:100;flex-shrink:0}
.page-wrap{padding:24px;max-width:1080px;width:100%;margin:0 auto}
.page{display:none;animation:fadeIn .3s ease}
.page.show{display:block}

/* ── SIDEBAR ── */
.sb-logo{padding:18px 16px 14px;border-bottom:1px solid rgba(0,140,255,.12)}
.sb-logo-text{font-family:'Playfair Display',serif;font-size:20px;font-weight:900;color:#fff;letter-spacing:1px;text-shadow:0 0 20px rgba(167,139,250,.5)}
.sb-logo-text em{color:#00c8ff;font-style:italic}
.sb-logo-sub{font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:#2a2018;margin-top:3px}
.sb-user{padding:12px 14px;border-bottom:1px solid rgba(0,140,255,.1);display:flex;align-items:center;gap:10px}
.sb-av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,rgba(0,160,255,.7),rgba(0,220,255,.5));border:1px solid rgba(0,180,255,.4);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:13px;font-weight:700;color:#fff;flex-shrink:0}
.sb-uname{font-size:12px;color:#f0e8d8;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-urole{font-size:9px;color:#4a3e42;letter-spacing:.5px;text-transform:uppercase}
.sb-nav{flex:1;padding:10px 8px;overflow-y:auto}
.nav-section{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#0a3060;padding:8px 10px 5px;margin-top:4px}
.nav-item{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:7px;cursor:pointer;transition:all .18s;color:#5a4e42;font-size:12px;font-weight:500;margin-bottom:2px;border:none;background:none;width:100%;text-align:left}
.nav-item:hover{background:rgba(255,255,255,.05);color:#b09878}
.nav-item.active{background:linear-gradient(90deg,rgba(0,160,255,.2),rgba(0,220,255,.08));color:#00d4ff;border-left:2px solid #00aaff;padding-left:8px}
.nav-icon{font-size:14px;flex-shrink:0;width:18px;text-align:center}
.nav-badge{margin-left:auto;background:rgba(0,220,255,.2);color:#00e5ff;font-size:9px;padding:1px 6px;border-radius:10px;font-weight:700}
.sb-footer{padding:12px 14px;border-top:1px solid rgba(0,140,255,.12)}
.signout-btn{width:100%;background:rgba(0,160,255,.08);border:1px solid rgba(0,160,255,.2);color:#00d4ff;padding:8px;border-radius:7px;font-family:'DM Sans',sans-serif;font-size:11px;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px}
.signout-btn:hover{background:rgba(239,68,68,.12);color:#f87171;border-color:rgba(239,68,68,.3)}

/* ── TOPBAR ── */
.tb-toggle{background:none;border:none;color:#5a4e42;cursor:pointer;font-size:18px;padding:5px;border-radius:6px;transition:all .15s}
.tb-toggle:hover{background:rgba(255,255,255,.06);color:#d4956a}
.tb-title{font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:#f0e8d8;flex:1}
.tb-right{display:flex;align-items:center;gap:8px}
.tb-date{font-size:11px;color:#4a3e42}

/* ── INPUTS ── */
.inp{width:100%;padding:10px 13px;background:rgba(0,30,80,.45);border:1px solid rgba(0,120,255,.18);border-radius:8px;color:#cfe4ff;font-family:'DM Sans',sans-serif;font-size:13px;outline:none;transition:border-color .2s}
.inp:focus{border-color:#00aaff;box-shadow:0 0 0 2px rgba(0,160,255,.18)}
.inp.err{border-color:#e07070}
select.inp{appearance:none;cursor:pointer}
textarea.inp{resize:vertical}
.sel-wrap{position:relative}
.sel-wrap::after{content:'▾';position:absolute;right:12px;top:50%;transform:translateY(-50%);pointer-events:none;color:#5a4e42;font-size:11px}

/* ── BUTTONS ── */
.btn-gold{background:linear-gradient(135deg,#0078ff,#00aaff);color:#fff;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;cursor:pointer;transition:all .2s;padding:9px 18px;box-shadow:0 4px 14px rgba(0,140,255,.35)}
.btn-gold:hover{opacity:.95;transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,180,255,.5)}
.btn-dark{background:rgba(255,255,255,.05);color:#8a7a6a;border:1px solid rgba(255,255,255,.1);padding:9px 16px;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer;transition:all .15s}
.btn-dark:hover{background:rgba(255,255,255,.1)}
.btn-red{background:rgba(224,112,112,.1);color:#c07070;border:1px solid rgba(224,112,112,.2);padding:8px 14px;border-radius:7px;font-family:'DM Sans',sans-serif;font-size:11px;cursor:pointer;transition:all .15s}
.btn-red:hover{background:rgba(224,112,112,.22);color:#e07070}
.btn-sms{background:linear-gradient(135deg,#00e5ff,#00aacc);color:#fff;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:600;cursor:pointer;transition:all .2s;padding:9px 16px;display:inline-flex;align-items:center;gap:6px}
.btn-sms:hover{opacity:.9;transform:translateY(-1px)}
.bulk-btn{background:rgba(0,30,80,.4);color:#2a6080;border:1px solid rgba(0,100,200,.12);padding:7px 13px;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:11px;cursor:pointer;transition:all .15s}
.bulk-btn:hover{background:rgba(0,80,200,.18);color:#00d4ff}

/* ── CARDS ── */
.card{background:rgba(0,30,70,.35);border:1px solid rgba(0,140,255,.14);border-radius:12px;backdrop-filter:blur(8px);transition:border-color .2s}
.card-head{padding:12px 16px;border-bottom:1px solid rgba(0,140,255,.12);display:flex;align-items:center;justify-content:space-between}
.card-title{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#00c8ff;font-weight:600}
.card-body{padding:14px 16px}

/* ── STATS ── */
.stats-row{display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap}
.stat-card{flex:1;min-width:110px;background:rgba(0,30,80,.4);border:1px solid rgba(0,140,255,.18);border-radius:11px;padding:14px;transition:all .2s;backdrop-filter:blur(6px)}
.stat-card:hover{background:rgba(0,100,255,.12);border-color:rgba(0,200,255,.4);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,160,255,.2)}
.stat-num{font-family:'Playfair Display',serif;font-size:26px;font-weight:700;line-height:1}
.stat-lbl{font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#4a3e42;margin-top:5px}
.stat-icon{font-size:18px;margin-bottom:7px}

/* ── BADGES ── */
.badge{display:inline-block;padding:2px 9px;border-radius:20px;font-size:10px;font-weight:500;letter-spacing:.4px}
.badge-green{background:rgba(126,170,146,.15);color:#7eaa92;border:1px solid rgba(126,170,146,.3)}
.badge-grey{background:rgba(255,255,255,.06);color:#888;border:1px solid rgba(255,255,255,.1)}
.badge-gold{background:rgba(0,200,255,.12);color:#00e5ff;border:1px solid rgba(0,200,255,.3)}
.badge-red{background:rgba(224,112,112,.15);color:#e07070;border:1px solid rgba(224,112,112,.3)}
.badge-blue{background:rgba(0,160,255,.15);color:#40c8ff;border:1px solid rgba(0,160,255,.35)}

/* ── FIELDS ── */
.field{margin-bottom:14px}
.field label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#2a6080;margin-bottom:5px}
.field-err{font-size:10px;color:#e07070;margin-top:3px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0 12px}
.sec-lbl{font-size:10px;text-transform:uppercase;letter-spacing:2px;color:#00b4d8;margin-bottom:11px;margin-top:4px}

/* ── MEMBERS ── */
.member-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px}
.member-card{background:rgba(0,25,65,.45);border:1px solid rgba(0,120,255,.12);border-radius:10px;padding:13px 15px;display:flex;align-items:center;gap:11px;cursor:pointer;transition:all .2s}
.member-card:hover{background:rgba(0,80,200,.15);border-color:rgba(0,180,255,.35);transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,140,255,.18)}
.avatar{border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-weight:700;color:#fff;flex-shrink:0;overflow:hidden}

/* ── FORM PANEL ── */
.form-panel{background:rgba(2,14,35,.8);border:1px solid rgba(0,140,255,.22);border-radius:13px;overflow:hidden;max-width:680px;margin:0 auto;backdrop-filter:blur(12px)}
.form-head{background:linear-gradient(135deg,rgba(0,120,255,.2),rgba(0,180,255,.06));border-bottom:1px solid rgba(0,140,255,.22);padding:20px 26px}
.form-body{padding:22px 26px}

/* ── PHOTO ── */
.photo-ring{width:86px;height:86px;border-radius:50%;border:2px dashed rgba(255,255,255,.14);background:rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;transition:all .2s;overflow:hidden}
.photo-ring:hover,.photo-ring.has-photo{border-color:#d4956a}

/* ── MODAL ── */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.78);z-index:500;display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(5px)}
.overlay.open{display:flex}
.modal{background:rgba(2,10,28,.96);border:1px solid rgba(0,140,255,.22);border-radius:14px;backdrop-filter:blur(20px);width:100%;max-width:520px;max-height:90vh;overflow-y:auto;box-shadow:0 28px 70px rgba(0,0,0,.85);animation:fadeUp .25s ease}
.modal-head{background:linear-gradient(135deg,rgba(0,120,255,.15),rgba(0,180,255,.04));border-bottom:1px solid rgba(139,92,246,.15);padding:18px 22px;display:flex;align-items:center;gap:13px}
.modal-close{background:none;border:none;color:#5a4e42;font-size:22px;cursor:pointer;line-height:1;margin-left:auto}
.modal-body{padding:18px 22px}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
.detail-key{font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#4a3e42;margin-bottom:3px}
.detail-val{font-size:12px;color:#c0b0a0;font-weight:500}
.modal-actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:14px}
.modal-notes{background:rgba(0,120,255,.07);border-left:3px solid rgba(0,180,255,.4);padding:9px 13px;border-radius:5px;margin-bottom:13px;font-size:12px;color:#8a7a6a;line-height:1.5}

/* ── TOAST ── */
#toast{position:fixed;top:18px;right:18px;z-index:9999;background:linear-gradient(135deg,#021428,#010e22);border:1px solid rgba(0,180,255,.5);color:#40d4ff;padding:12px 18px;border-radius:9px;font-size:12px;font-weight:500;box-shadow:0 10px 36px rgba(0,0,0,.6);display:none;animation:toastIn .3s ease;max-width:320px}

/* ── ATTENDANCE ── */
.att-row{display:flex;align-items:center;justify-content:space-between;padding:11px 14px;background:rgba(0,25,65,.4);border:1px solid rgba(0,100,200,.1);border-radius:8px;margin-bottom:7px;transition:border-color .2s}
.att-row:hover{border-color:rgba(0,180,255,.4)}
.mark-btn{border:none;cursor:pointer;padding:5px 13px;border-radius:18px;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:500;transition:all .15s}
.mark-present{background:rgba(126,170,146,.12);color:#7eaa92}
.mark-present.on{background:linear-gradient(135deg,#10b981,#059669);color:#fff;box-shadow:0 3px 12px rgba(16,185,129,.35)}
.mark-absent{background:rgba(224,112,112,.1);color:#e07070}
.mark-absent.on{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;box-shadow:0 3px 12px rgba(239,68,68,.35)}
.sub-tabs{display:flex;border-bottom:1px solid rgba(255,255,255,.07);margin-bottom:18px}
.sub-tab{background:none;border:none;border-bottom:2px solid transparent;color:#2a5070;font-family:'DM Sans',sans-serif;font-size:11px;letter-spacing:1px;text-transform:uppercase;padding:9px 18px;cursor:pointer;transition:all .2s}
.sub-tab.active{color:#00e0ff;border-bottom-color:#00aaff}
.att-table{width:100%;border-collapse:collapse}
.att-table th{padding:8px 14px;text-align:left;font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#5a4e42;font-weight:500;border-bottom:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.02)}
.att-table td{padding:9px 14px;font-size:12px;border-bottom:1px solid rgba(255,255,255,.04);color:#7a6a5a}
.att-table td.nc{font-family:'Playfair Display',serif;font-size:13px;color:#f0e8d8;font-weight:700}

/* ── BIRTHDAYS ── */
.reminder-card{background:rgba(0,25,65,.4);border:1px solid rgba(0,120,255,.12);border-radius:9px;padding:11px 14px;display:flex;align-items:center;gap:11px;margin-bottom:7px;transition:all .2s}
.reminder-card:hover{background:rgba(0,80,200,.12);border-color:rgba(0,180,255,.3)}
.days-pill{display:inline-block;padding:2px 9px;border-radius:18px;font-size:10px;font-weight:600;white-space:nowrap}
.tab-pills{display:flex;gap:5px;margin-bottom:18px;flex-wrap:wrap}
.tab-pill{background:rgba(0,30,80,.3);border:1px solid rgba(0,100,200,.15);color:#2a5070;padding:5px 13px;border-radius:18px;font-family:'DM Sans',sans-serif;font-size:11px;cursor:pointer;transition:all .2s}
.tab-pill.active{background:linear-gradient(135deg,rgba(0,140,255,.2),rgba(0,200,255,.1));border-color:rgba(0,180,255,.45);color:#00d4ff;font-weight:600}

/* ── VISITORS ── */
.visitor-row{background:rgba(0,25,65,.4);border:1px solid rgba(0,100,200,.12);border-radius:9px;padding:12px 14px;display:flex;align-items:center;gap:11px;margin-bottom:7px;cursor:pointer;transition:all .2s}
.visitor-row:hover{background:rgba(0,80,200,.12);border-color:rgba(0,160,255,.3)}
.vfb{display:inline-block;padding:2px 8px;border-radius:18px;font-size:10px;font-weight:500}
.vfb-new{background:rgba(126,170,146,.15);color:#7eaa92;border:1px solid rgba(126,170,146,.3)}
.vfb-contacted{background:rgba(212,149,106,.12);color:#d4956a;border:1px solid rgba(212,149,106,.3)}
.vfb-returning{background:rgba(143,168,212,.15);color:#8fa8d4;border:1px solid rgba(143,168,212,.3)}

/* ── SMS ── */
.sms-tpl-card{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:9px;padding:13px 15px;cursor:pointer;transition:all .2s;margin-bottom:8px}
.sms-tpl-card:hover{background:rgba(74,144,217,.08);border-color:rgba(74,144,217,.25)}
.sms-chip{display:inline-flex;align-items:center;background:rgba(74,144,217,.1);border:1px solid rgba(74,144,217,.25);color:#6aabee;padding:2px 9px;border-radius:18px;font-size:10px;margin:2px}
.sms-log-row{padding:11px 14px;border-bottom:1px solid rgba(255,255,255,.05);font-size:12px}
.sms-log-row:last-child{border-bottom:none}
.spinner{display:inline-block;width:12px;height:12px;border:2px solid rgba(255,255,255,.2);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:5px}

/* ── DASHBOARD ── */
.activity-item{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.05)}
.activity-item:last-child{border-bottom:none}
.act-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;margin-top:4px}
.qa-card{background:rgba(0,25,65,.4);border:1px solid rgba(0,120,255,.14);border-radius:10px;padding:14px;cursor:pointer;transition:all .22s;text-align:center}
.qa-card:hover{background:linear-gradient(135deg,rgba(0,120,255,.18),rgba(0,180,255,.08));border-color:rgba(0,200,255,.4);transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,160,255,.2)}
.qa-icon{font-size:22px;margin-bottom:7px}
.qa-label{font-size:11px;color:#b09878;font-weight:500}
.chart-bar-wrap{display:flex;align-items:flex-end;gap:5px;height:72px}
.chart-bar{flex:1;border-radius:3px 3px 0 0;transition:height .4s;cursor:pointer;position:relative;min-height:4px}
.chart-bar:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100%+4px);left:50%;transform:translateX(-50%);background:#1a1208;color:#d4956a;font-size:9px;padding:2px 7px;border-radius:4px;white-space:nowrap;font-family:'DM Sans',sans-serif}
.chart-lbl{font-size:8px;color:#3a3028;text-align:center;margin-top:3px}
.fu-item{display:flex;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.05)}
.fu-item:last-child{border-bottom:none}
.session-box{background:rgba(0,60,160,.08);border:1px solid rgba(0,140,255,.18);border-radius:10px;padding:14px 18px;margin-bottom:18px;display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end}
.session-field{flex:1;min-width:150px}
.session-field label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#2a5070;margin-bottom:5px}
.filters-row{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center}
.mod-tag{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#00c8ff;margin-bottom:6px}
.mod-title{font-size:clamp(22px,3.5vw,36px);font-weight:700;color:#f0e8d8;line-height:1.1}
.mod-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px;flex-wrap:wrap;gap:10px}
.empty-state{text-align:center;padding:50px 20px;color:#4a3e42}
.empty-icon{font-size:32px;margin-bottom:12px}

/* ── LOGIN ── */
.login-wrap{min-height:100vh;display:flex;align-items:stretch;position:relative;overflow:hidden;width:100%;background:linear-gradient(135deg,#020c1b 0%,#021428 50%,#010e22 100%)}
.login-left{flex:1;display:none;flex-direction:column;justify-content:center;padding:52px 48px;background:rgba(0,80,180,.06);border-right:1px solid rgba(0,140,255,.14)}
.login-right{width:100%;max-width:440px;display:flex;flex-direction:column;justify-content:center;padding:40px 32px;background:rgba(0,60,160,.06);border-left:1px solid rgba(0,140,255,.1)}
@media(min-width:800px){.login-left{display:flex!important}.mob-logo{display:none!important}}
@media(max-width:650px){#sidebar{transform:translateX(-230px)!important}#main-content{margin-left:0!important}.grid2,.grid3{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr}.page-wrap{padding:14px}}
</style>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
<div id="toast"></div>

<!-- ═══ LOGIN ═══ -->
<div id="login-screen" style="width:100%">
<div class="login-wrap">
  <div style="position:absolute;inset:0;pointer-events:none;overflow:hidden">
    <div style="position:absolute;top:-20%;left:-10%;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,rgba(0,120,255,.15) 0%,transparent 70%)"></div>
    <div style="position:absolute;bottom:-10%;right:-5%;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle,rgba(0,200,255,.1) 0%,transparent 70%)"></div>
    <div style="position:absolute;top:50%;left:36%;width:140px;height:140px;border-radius:50%;border:1px solid rgba(0,140,255,.1);transform:translate(-50%,-50%)"></div>
    <div style="position:absolute;top:50%;left:36%;width:300px;height:300px;border-radius:50%;border:1px solid rgba(0,180,255,.07);transform:translate(-50%,-50%)"></div>
    <div style="position:absolute;top:50%;left:36%;width:480px;height:480px;border-radius:50%;border:1px solid rgba(0,180,255,.04);transform:translate(-50%,-50%)"></div>
  </div>
  <div class="login-left">
    <div style="margin-bottom:48px">
      <img src="data:image/webp;base64," style="width:90px;height:90px;border-radius:50%;object-fit:cover;margin-bottom:16px;border:3px solid rgba(212,149,106,0.4)"/><div style="font-family:'Playfair Display',serif;font-size:30px;font-weight:900;color:#f0e8d8;letter-spacing:1px">CACI O6 Assembly</div>
      <div style="font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#3a3028;margin-top:7px">Church Management System</div>
    </div>
    <h2 style="font-size:clamp(24px,3vw,44px);font-weight:700;color:#f0e8d8;line-height:1.1;margin-bottom:13px">Serving your<br/><span style="color:#d4956a;font-style:italic">congregation</span><br/>with grace.</h2>
    <p style="font-size:13px;color:#5a4e42;line-height:1.8;max-width:340px;margin-bottom:36px">Manage members, track attendance, send SMS and cultivate the heart of your ministry — all in one place.</p>
    <div style="display:flex;flex-direction:column;gap:9px">
      <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:10px 13px;font-size:12px;color:#9a8a7a">👥 Member Registry with Photo Profiles</div>
      <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:10px 13px;font-size:12px;color:#9a8a7a">✅ Attendance Tracking &amp; Print Reports</div>
      <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:10px 13px;font-size:12px;color:#9a8a7a">📱 BulkSMS — Individual &amp; Mass Messaging</div>
      <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:10px 13px;font-size:12px;color:#9a8a7a">🎂 Birthday &amp; Anniversary Reminders</div>
      <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:10px 13px;font-size:12px;color:#9a8a7a">🙋 Visitor Log &amp; Follow-up Tracker</div>
    </div>
    <div style="margin-top:auto;padding-top:36px;border-top:1px solid rgba(255,255,255,.05)">
      <p style="font-family:'Playfair Display',serif;font-size:13px;color:#4a3e42;font-style:italic;line-height:1.7">"And let us consider how we may spur one another on toward love and good deeds."</p>
      <p style="font-size:9px;color:#3a3028;margin-top:5px;letter-spacing:1px">— Hebrews 10:24</p>
    </div>
  </div>
  <div class="login-right">
    <div class="mob-logo" style="margin-bottom:32px;text-align:center">
      <img src="data:image/webp;base64," style="width:70px;height:70px;border-radius:50%;object-fit:cover;margin-bottom:12px;border:3px solid rgba(212,149,106,0.4)"/><div style="font-family:'Playfair Display',serif;font-size:26px;font-weight:900;color:#f0e8d8;letter-spacing:1px">CACI O6 Assembly</div>
      <div style="font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#3a3028;margin-top:6px">Church Management System</div>
    </div>
    <div style="margin-bottom:26px">
      <div style="font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#d4956a;margin-bottom:9px">Welcome back</div>
      <h2 style="font-size:26px;font-weight:700;color:#f0e8d8;margin-bottom:4px">Sign In</h2>
      <p style="font-size:12px;color:#5a4e42;line-height:1.6">Enter your credentials to access the dashboard.</p>
    </div>

    <div class="field"><label>Username</label><input class="inp" type="text" id="l-user" placeholder="Enter username" autocomplete="username" onkeydown="if(event.key==='Enter')doLogin()"/></div>
    <div class="field"><label>Password</label>
      <div style="position:relative"><input class="inp" type="password" id="l-pass" placeholder="Enter password" style="padding-right:44px" autocomplete="current-password" onkeydown="if(event.key==='Enter')doLogin()"/>
      <button onclick="togglePass()" style="position:absolute;right:11px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#5a4e42;font-size:14px;line-height:1;padding:4px" id="pass-eye">👁</button></div>
    </div>
    <div id="login-err" style="background:rgba(224,112,112,.1);border:1px solid rgba(224,112,112,.25);border-radius:7px;padding:9px 13px;font-size:12px;color:#e07070;display:none;margin-bottom:10px">⚠ Invalid username or password.</div>
    <button class="btn-gold" onclick="doLogin()" id="login-btn" style="width:100%;padding:12px;font-size:13px;margin-top:4px;box-shadow:0 8px 22px rgba(212,149,106,.26)">Sign In →</button>
    <div style="text-align:center;margin-top:22px;font-size:10px;color:#2a2018">© 2026 CACI O6 Assembly · Secure Church Management</div>
  </div>
</div>
</div>

<!-- ═══ APP SHELL ═══ -->
<div id="app-shell" style="display:none;flex:1">
<div id="sidebar">
  <div class="sb-logo"><img src="data:image/webp;base64," style="width:52px;height:52px;border-radius:50%;object-fit:cover;margin-bottom:8px;display:block;border:2px solid rgba(0,200,255,0.3)"/><div class="sb-logo-text">CACI O6 Assembly</div><div class="sb-logo-sub">Church Management</div></div>
  <div class="sb-user"><div class="sb-av" id="sb-av">P</div><div><div class="sb-uname" id="sb-name">—</div><div class="sb-urole" id="sb-role">—</div></div></div>
  <div class="sb-nav">
    <div class="nav-section">Main</div>
    <button class="nav-item active" id="ni-dashboard" onclick="goPage('dashboard')"><span class="nav-icon">🏠</span>Dashboard</button>
    <button class="nav-item" id="ni-members" onclick="goPage('members')"><span class="nav-icon">👥</span>Members</button>
    <button class="nav-item" id="ni-attendance" onclick="goPage('attendance')"><span class="nav-icon">✅</span>Attendance</button>
    <div class="nav-section">Communication</div>
    <button class="nav-item" id="ni-sms" onclick="goPage('sms')"><span class="nav-icon">📱</span>BulkSMS</button>
    <div class="nav-section">Community</div>
    <button class="nav-item" id="ni-birthdays" onclick="goPage('birthdays')"><span class="nav-icon">🎂</span>Birthdays <span class="nav-badge" id="bday-nav-badge" style="display:none">0</span></button>
    <button class="nav-item" id="ni-visitors" onclick="goPage('visitors')"><span class="nav-icon">🙋</span>Visitors</button>
    <div class="nav-section">System</div>
    <button class="nav-item" id="ni-settings" onclick="goPage('settings')"><span class="nav-icon">⚙</span>Settings</button>
  </div>
  <div class="sb-footer"><button class="signout-btn" onclick="signOut()">⬅ Sign Out</button></div>
</div>

<div id="main-content">
  <div id="topbar">
    <button class="tb-toggle" onclick="toggleSidebar()">☰</button>
    <div class="tb-title" id="tb-title">Dashboard</div>
    <div class="tb-right">
      <span id="tb-role-badge" style="display:inline-block"></span>
      <div class="tb-date" id="tb-date"></div>
      <button class="btn-sms" onclick="goPage('sms')" style="padding:6px 12px;font-size:10px">📱 Send SMS</button>
    </div>
  </div>

  <!-- ══ DASHBOARD ══ -->
  <div id="page-dashboard" class="page show">
    <div class="page-wrap">
      <div style="margin-bottom:20px">
        <div class="mod-tag">Overview</div>
        <h1 class="mod-title" id="dash-greet">Good day</h1>
        <p style="font-size:12px;color:#5a4e42;margin-top:3px" id="dash-date-sub"></p>
      </div>
      <div id="dash-reconnect-banner" style="display:none;background:rgba(212,100,100,.1);border:1px solid rgba(212,100,100,.25);border-radius:10px;padding:12px 16px;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;gap:12px">
        <div style="font-size:12px;color:#e07070">⚠️ <strong>Supabase not connected</strong> — your data may not be loading. Go to Settings to reconnect.</div>
        <button onclick="goPage('settings')" style="background:rgba(212,100,100,.2);color:#e07070;border:1px solid rgba(212,100,100,.3);padding:6px 14px;border-radius:7px;font-family:'DM Sans',sans-serif;font-size:11px;cursor:pointer;white-space:nowrap">Go to Settings</button>
      </div>
      <div class="stats-row" id="dash-stats"></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
        <div class="card">
          <div class="card-head" style="display:flex;justify-content:space-between;align-items:center"><span class="card-title">&#128107; Gender Breakdown</span><button onclick="printGender()" style="background:rgba(143,168,212,.15);color:#8fa8d4;border:1px solid rgba(143,168,212,.3);padding:4px 10px;border-radius:6px;font-size:10px;cursor:pointer">🖨 Print</button></div>
          <div class="card-body" id="gender-widget"></div>
        </div>
        <div class="card">
          <div class="card-head" style="display:flex;justify-content:space-between;align-items:center"><span class="card-title">&#128197; Day Borns</span><button onclick="printAllDayBorns()" style="background:rgba(212,149,106,.15);color:#d4956a;border:1px solid rgba(212,149,106,.3);padding:4px 10px;border-radius:6px;font-size:10px;cursor:pointer">🖨 Print</button></div>
          <div class="card-body" id="dayborn-widget"></div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:10px;margin-bottom:14px" id="dayborn-cards">
        <div class="card" style="text-align:center;cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #d4956a'" onmouseout="this.style.boxShadow=''" onclick="showDayBornModal('Sunday','#d4956a')">
          <div style="font-size:10px;color:#d4956a;font-weight:700;padding:8px 0 2px">SUN</div>
          <div style="font-size:26px;font-weight:900;color:#d4956a" id="day-sun">0</div>
          <div style="font-size:9px;color:#5a4e42;padding-bottom:8px">Sunday</div>
        </div>
        <div class="card" style="text-align:center;cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #8fa8d4'" onmouseout="this.style.boxShadow=''" onclick="showDayBornModal('Monday','#8fa8d4')">
          <div style="font-size:10px;color:#8fa8d4;font-weight:700;padding:8px 0 2px">MON</div>
          <div style="font-size:26px;font-weight:900;color:#8fa8d4" id="day-mon">0</div>
          <div style="font-size:9px;color:#5a4e42;padding-bottom:8px">Monday</div>
        </div>
        <div class="card" style="text-align:center;cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #7eaa92'" onmouseout="this.style.boxShadow=''" onclick="showDayBornModal('Tuesday','#7eaa92')">
          <div style="font-size:10px;color:#7eaa92;font-weight:700;padding:8px 0 2px">TUE</div>
          <div style="font-size:26px;font-weight:900;color:#7eaa92" id="day-tue">0</div>
          <div style="font-size:9px;color:#5a4e42;padding-bottom:8px">Tuesday</div>
        </div>
        <div class="card" style="text-align:center;cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #c47e8a'" onmouseout="this.style.boxShadow=''" onclick="showDayBornModal('Wednesday','#c47e8a')">
          <div style="font-size:10px;color:#c47e8a;font-weight:700;padding:8px 0 2px">WED</div>
          <div style="font-size:26px;font-weight:900;color:#c47e8a" id="day-wed">0</div>
          <div style="font-size:9px;color:#5a4e42;padding-bottom:8px">Wednesday</div>
        </div>
        <div class="card" style="text-align:center;cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #6aabee'" onmouseout="this.style.boxShadow=''" onclick="showDayBornModal('Thursday','#6aabee')">
          <div style="font-size:10px;color:#6aabee;font-weight:700;padding:8px 0 2px">THU</div>
          <div style="font-size:26px;font-weight:900;color:#6aabee" id="day-thu">0</div>
          <div style="font-size:9px;color:#5a4e42;padding-bottom:8px">Thursday</div>
        </div>
        <div class="card" style="text-align:center;cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #f0c060'" onmouseout="this.style.boxShadow=''" onclick="showDayBornModal('Friday','#f0c060')">
          <div style="font-size:10px;color:#f0c060;font-weight:700;padding:8px 0 2px">FRI</div>
          <div style="font-size:26px;font-weight:900;color:#f0c060" id="day-fri">0</div>
          <div style="font-size:9px;color:#5a4e42;padding-bottom:8px">Friday</div>
        </div>
        <div class="card" style="text-align:center;cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #9b8fd4'" onmouseout="this.style.boxShadow=''" onclick="showDayBornModal('Saturday','#9b8fd4')">
          <div style="font-size:10px;color:#9b8fd4;font-weight:700;padding:8px 0 2px">SAT</div>
          <div style="font-size:26px;font-weight:900;color:#9b8fd4" id="day-sat">0</div>
          <div style="font-size:9px;color:#5a4e42;padding-bottom:8px">Saturday</div>
        </div>
      </div>
      <!-- Ministry Widgets -->
      <div style="margin-bottom:6px;padding:4px 0">
        <span style="font-size:11px;color:#5a4e42;text-transform:uppercase;letter-spacing:1px;font-weight:700">&#9997; Ministries & Fellowships</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px" id="ministry-cards">
        <div class="card" style="cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #8fa8d4'" onmouseout="this.style.boxShadow=''" onclick="showMinistryModal('Youth','#8fa8d4')">
          <div class="card-head" style="border-bottom:2px solid #8fa8d4"><span class="card-title" style="color:#8fa8d4">&#128121; Youth</span></div>
          <div class="card-body" style="text-align:center;padding:10px 0">
            <div style="font-size:32px;font-weight:900;color:#8fa8d4" id="min-youth">0</div>
            <div style="font-size:10px;color:#5a4e42;margin-top:2px">Members</div>
            <button onclick="event.stopPropagation();printMinistry('Youth','#8fa8d4')" style="margin-top:8px;background:rgba(143,168,212,.15);color:#8fa8d4;border:1px solid rgba(143,168,212,.3);padding:5px 12px;border-radius:6px;font-size:11px;cursor:pointer;width:100%">🖨 Print</button>
          </div>
        </div>
        <div class="card" style="cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #c47e8a'" onmouseout="this.style.boxShadow=''" onclick="showMinistryModal('Young Ladies','#c47e8a')">
          <div class="card-head" style="border-bottom:2px solid #c47e8a"><span class="card-title" style="color:#c47e8a">&#128145; Young Ladies</span></div>
          <div class="card-body" style="text-align:center;padding:10px 0">
            <div style="font-size:32px;font-weight:900;color:#c47e8a" id="min-youngladies">0</div>
            <div style="font-size:10px;color:#5a4e42;margin-top:2px">Members</div>
            <button onclick="event.stopPropagation();printMinistry('Young Ladies','#c47e8a')" style="margin-top:8px;background:rgba(196,126,138,.15);color:#c47e8a;border:1px solid rgba(196,126,138,.3);padding:5px 12px;border-radius:6px;font-size:11px;cursor:pointer;width:100%">🖨 Print</button>
          </div>
        </div>
        <div class="card" style="cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #6aabee'" onmouseout="this.style.boxShadow=''" onclick="showMinistryModal('Men Fellowship','#6aabee')">
          <div class="card-head" style="border-bottom:2px solid #6aabee"><span class="card-title" style="color:#6aabee">&#128086; Men Fellowship</span></div>
          <div class="card-body" style="text-align:center;padding:10px 0">
            <div style="font-size:32px;font-weight:900;color:#6aabee" id="min-men">0</div>
            <div style="font-size:10px;color:#5a4e42;margin-top:2px">Members</div>
            <button onclick="event.stopPropagation();printMinistry('Men Fellowship','#6aabee')" style="margin-top:8px;background:rgba(106,171,238,.15);color:#6aabee;border:1px solid rgba(106,171,238,.3);padding:5px 12px;border-radius:6px;font-size:11px;cursor:pointer;width:100%">🖨 Print</button>
          </div>
        </div>
        <div class="card" style="cursor:pointer;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 0 0 2px #7eaa92'" onmouseout="this.style.boxShadow=''" onclick="showMinistryModal('Good Women Fellowship','#7eaa92')">
          <div class="card-head" style="border-bottom:2px solid #7eaa92"><span class="card-title" style="color:#7eaa92">&#128140; Good Women</span></div>
          <div class="card-body" style="text-align:center;padding:10px 0">
            <div style="font-size:32px;font-weight:900;color:#7eaa92" id="min-goodwomen">0</div>
            <div style="font-size:10px;color:#5a4e42;margin-top:2px">Members</div>
            <button onclick="event.stopPropagation();printMinistry('Good Women Fellowship','#7eaa92')" style="margin-top:8px;background:rgba(126,170,146,.15);color:#7eaa92;border:1px solid rgba(126,170,146,.3);padding:5px 12px;border-radius:6px;font-size:11px;cursor:pointer;width:100%">🖨 Print</button>
          </div>
        </div>
      </div>
      <!-- Elders & Deacons Modal -->
      <div id="elders-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9999;align-items:center;justify-content:center">
        <div style="background:#0d1b2a;border:1px solid rgba(255,255,255,.1);border-radius:16px;width:90%;max-width:620px;max-height:85vh;overflow:hidden;display:flex;flex-direction:column">
          <div style="padding:18px 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.07)">
            <div>
              <div style="font-size:20px;font-weight:900;color:#c47e8a">⛪ Elders & Deacons</div>
              <div id="elders-modal-sub" style="font-size:11px;color:#5a4e42;margin-top:2px"></div>
            </div>
            <div style="display:flex;gap:8px">
              <button onclick="printElders()" style="background:rgba(196,126,138,.15);color:#c47e8a;border:1px solid rgba(196,126,138,.3);padding:7px 14px;border-radius:8px;font-size:12px;cursor:pointer">🖨 Print</button>
              <button onclick="document.getElementById('elders-modal').style.display='none'" style="background:rgba(255,255,255,.06);color:#f0e8d8;border:none;padding:7px 12px;border-radius:8px;font-size:12px;cursor:pointer">✕ Close</button>
            </div>
          </div>
          <div id="elders-modal-body" style="overflow-y:auto;padding:16px 20px;flex:1"></div>
        </div>
      </div>
      <!-- Ministry Modal -->
      <div id="ministry-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9999;align-items:center;justify-content:center">
        <div style="background:#0d1b2a;border:1px solid rgba(255,255,255,.1);border-radius:16px;width:90%;max-width:620px;max-height:85vh;overflow:hidden;display:flex;flex-direction:column">
          <div id="ministry-modal-head" style="padding:18px 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.07)">
            <div>
              <div id="ministry-modal-title" style="font-size:20px;font-weight:900;color:#f0e8d8"></div>
              <div id="ministry-modal-sub" style="font-size:11px;color:#5a4e42;margin-top:2px"></div>
            </div>
            <div style="display:flex;gap:8px">
              <button id="ministry-print-btn" style="background:rgba(212,149,106,.15);color:#d4956a;border:1px solid rgba(212,149,106,.3);padding:7px 14px;border-radius:8px;font-size:12px;cursor:pointer">🖨 Print</button>
              <button onclick="document.getElementById('ministry-modal').style.display='none'" style="background:rgba(255,255,255,.06);color:#f0e8d8;border:none;padding:7px 12px;border-radius:8px;font-size:12px;cursor:pointer">✕ Close</button>
            </div>
          </div>
          <div id="ministry-modal-body" style="overflow-y:auto;padding:16px 20px;flex:1"></div>
        </div>
      </div>
      <!-- Day Born Modal -->
      <div id="dayborn-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9999;align-items:center;justify-content:center">
        <div style="background:#0d1b2a;border:1px solid rgba(255,255,255,.1);border-radius:16px;width:90%;max-width:600px;max-height:85vh;overflow:hidden;display:flex;flex-direction:column">
          <div id="dayborn-modal-head" style="padding:18px 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.07)">
            <div>
              <div id="dayborn-modal-title" style="font-family:'Playfair Display',serif;font-size:20px;font-weight:900;color:#f0e8d8"></div>
              <div id="dayborn-modal-sub" style="font-size:11px;color:#5a4e42;margin-top:2px"></div>
            </div>
            <div style="display:flex;gap:8px;align-items:center">
              <button onclick="printDayBorn()" style="background:rgba(212,149,106,.15);color:#d4956a;border:1px solid rgba(212,149,106,.3);padding:7px 14px;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer">🖨 Print</button>
              <button onclick="document.getElementById('dayborn-modal').style.display='none'" style="background:rgba(255,255,255,.06);color:#f0e8d8;border:none;padding:7px 12px;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer">✕ Close</button>
            </div>
          </div>
          <div id="dayborn-modal-body" style="overflow-y:auto;padding:16px 20px;flex:1"></div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
        <div class="card">
          <div class="card-head"><span class="card-title">Quick Actions</span></div>
          <div class="card-body"><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px" id="quick-actions"></div></div>
        </div>
        <div class="card">
          <div class="card-head"><span class="card-title">Recent Activity</span></div>
          <div class="card-body" id="activity-feed" style="max-height:190px;overflow-y:auto"></div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:14px;margin-bottom:14px">
        <div class="card">
          <div class="card-head"><span class="card-title">Attendance Trend</span><span style="font-size:10px;color:#4a3e42">Last 6 sessions</span></div>
          <div class="card-body">
            <div class="chart-bar-wrap" id="att-chart"></div>
            <div style="display:flex;justify-content:space-between;margin-top:4px" id="att-chart-labels"></div>
          </div>
        </div>
        <div class="card">
          <div class="card-head"><span class="card-title">Pending Follow-ups</span><span class="badge badge-gold" id="followup-count">0</span></div>
          <div class="card-body" id="followup-list" style="max-height:190px;overflow-y:auto"></div>
        </div>
      </div>
      <div class="card">
        <div class="card-head"><span class="card-title">🎂 Birthdays This Week</span><button class="btn-sms" onclick="sendBirthdaySMS()" style="padding:4px 11px;font-size:10px">📱 SMS All</button></div>
        <div class="card-body" id="dash-bdays"></div>
      </div>
    </div>
  </div>

  <!-- ══ MEMBERS ══ -->
  <div id="page-members" class="page">
    <div class="page-wrap">
      <div class="mod-header">
        <div><div class="mod-tag">Registry</div><div class="mod-title">Member Directory</div></div>
        <div id="mem-hdr-btn" style="margin-top:8px"></div>
      </div>
      <div id="mem-dir">
        <div class="stats-row" id="mem-stats"></div>
        <div class="filters-row">
          <input class="inp" type="search" id="mem-search" placeholder="Search members…" oninput="renderDir()" style="flex:1;min-width:150px"/>
          <div class="sel-wrap" style="min-width:130px"><select class="inp" id="mem-ftype" onchange="renderDir()"><option value="">All Types</option><option>Full Member</option><option>Associate Member</option><option>Youth Member</option><option>Elder</option><option>Deacon</option><option>Visitor</option></select></div>
          <div class="sel-wrap" style="min-width:115px"><select class="inp" id="mem-fstatus" onchange="renderDir()"><option value="">All Statuses</option><option>Active</option><option>Inactive</option><option>Transferred</option></select></div>
        </div>
        <div class="member-grid" id="member-grid"></div>
      </div>
      <div id="mem-form" style="display:none">
        <div class="form-panel">
          <div class="form-head"><h2 id="form-title" style="font-size:19px;color:#f0e8d8;font-weight:700;margin-bottom:3px">Register New Member</h2><p id="form-sub" style="font-size:12px;color:#8a7a6a">Complete the form to add a new congregant</p></div>
          <div class="form-body">
            <div class="sec-lbl">Profile Photo</div>
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px">
              <div class="photo-ring" id="photo-ring" onclick="document.getElementById('photo-file').click()">
                <div id="photo-placeholder" style="text-align:center"><div style="font-size:20px;margin-bottom:3px">📷</div><div style="font-size:9px;color:#5a4e42">Upload</div></div>
                <img id="photo-preview" src="" alt="" style="display:none;width:100%;height:100%;object-fit:cover"/>
              </div>
              <div>
                <button class="btn-gold" onclick="document.getElementById('photo-file').click()" style="padding:7px 14px;font-size:11px;display:block;margin-bottom:6px" id="photo-upload-btn">Upload Photo</button>
                <button id="photo-remove-btn" onclick="clearPhoto()" style="display:none;background:rgba(224,112,112,.1);color:#e07070;border:1px solid rgba(224,112,112,.25);padding:5px 12px;border-radius:7px;font-family:'DM Sans',sans-serif;font-size:10px;cursor:pointer;margin-bottom:5px">Remove</button>
                <div style="font-size:10px;color:#4a3e42;line-height:1.5">JPG/PNG · Passport size</div>
              </div>
              <input id="photo-file" type="file" accept="image/*" style="display:none" onchange="handlePhoto(this)"/>
            </div>
            <div class="sec-lbl">Personal Information</div>
            <div class="grid2">
              <div class="field"><label>First Name <span style="color:#d4956a">*</span></label><input class="inp" type="text" id="f-first" placeholder="First name"/><div class="field-err" id="e-first"></div></div>
              <div class="field"><label>Last Name <span style="color:#d4956a">*</span></label><input class="inp" type="text" id="f-last" placeholder="Last name"/><div class="field-err" id="e-last"></div></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Gender <span style="color:#d4956a">*</span></label>
<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:4px" id="gender-btns">
  <button type="button" onclick="setGender('Male')" id="g-male" style="flex:1;padding:9px 14px;border-radius:8px;border:1px solid rgba(0,100,200,.2);background:rgba(0,25,65,.4);color:#3a7090;font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px">♂ Male</button>
  <button type="button" onclick="setGender('Female')" id="g-female" style="flex:1;padding:9px 14px;border-radius:8px;border:1px solid rgba(139,92,246,.2);background:rgba(255,255,255,.04);color:#8878c0;font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px">♀ Female</button>
  <button type="button" onclick="setGender('Other')" id="g-other" style="flex:1;padding:9px 14px;border-radius:8px;border:1px solid rgba(139,92,246,.2);background:rgba(255,255,255,.04);color:#8878c0;font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px">⚧ Other</button>
</div>
<input type="hidden" id="f-gender" value=""/>
<div class="field-err" id="e-gender"></div></div>
              <div class="field"><label>Date of Birth</label><input class="inp" type="date" id="f-dob" oninput="updateDayBorn()"/></div>
              <div class="field"><label>Day Born</label><input class="inp" type="text" id="f-dayborn" placeholder="Auto-filled from DOB" readonly style="background:rgba(255,255,255,.04);color:#d4956a;font-weight:600;cursor:default"/></div>
            </div>
            <div class="field"><label>Phone Number <span style="color:#d4956a">*</span></label><input class="inp" type="tel" id="f-phone" placeholder="e.g. 055-123-4567"/><div class="field-err" id="e-phone"></div></div>
            <div class="grid2">
              <div class="field"><label>Position / Role</label><div class="sel-wrap"><select class="inp" id="f-position"><option value="">Select position…</option><option>Pastor</option><option>Assistant Pastor</option><option>Elder</option><option>Deacon</option><option>Deaconess</option><option>Choir Member</option><option>Choir Director</option><option>Sunday School Teacher</option><option>Youth Leader</option><option>Usher</option><option>Prayer Team</option><option>Evangelism Team</option><option>Media Team</option><option>Finance Committee</option><option>General Member</option></select></div></div>
              <div class="field"><label>Home Address</label><input class="inp" type="text" id="f-address" placeholder="Street, City"/></div>
            </div>
            <div class="field">
              <label>Location (Google Maps Link)</label>
              <div style="display:flex;gap:8px;align-items:flex-start">
                <input class="inp" type="url" id="f-location" placeholder="Paste Google Maps link or click pin button" style="flex:1"/>
                <button type="button" onclick="openGoogleMaps()" title="Open Google Maps to get location link" style="background:linear-gradient(135deg,#34a853,#1a8a3c);color:#fff;border:none;border-radius:8px;padding:10px 14px;font-size:16px;cursor:pointer;flex-shrink:0;transition:all .2s;height:42px;display:flex;align-items:center;justify-content:center" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">📍</button>
              </div>
              <div style="font-size:10px;color:#5a4e80;margin-top:4px">Go to Google Maps → search location → click Share → Copy link → paste above</div>
              <div id="f-location-preview" style="display:none;margin-top:8px;background:rgba(52,168,83,.08);border:1px solid rgba(52,168,83,.2);border-radius:7px;padding:8px 12px;font-size:11px;color:#34d399;display:flex;align-items:center;gap:8px"></div>
            </div>
            <div class="sec-lbl" style="margin-top:5px">Church Information</div>
            <div class="grid2">
              <div class="field"><label>Member Type</label><div class="sel-wrap"><select class="inp" id="f-type"><option>Full Member</option><option>Associate Member</option><option>Youth Member</option><option>Elder</option><option>Deacon</option><option>Visitor</option></select></div></div>
              <div class="field"><label>Ministry / Fellowship</label><div class="sel-wrap"><select class="inp" id="f-ministry"><option value="">-- Select Ministry --</option><option>Youth</option><option>Young Ladies</option><option>Men Fellowship</option><option>Good Women Fellowship</option></select></div></div>
              <div class="field"><label>Status</label><div class="sel-wrap"><select class="inp" id="f-status"><option>Active</option><option>Inactive</option><option>Transferred</option></select></div></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Family Group</label><input class="inp" type="text" id="f-family" placeholder="e.g. Owusu Family"/></div>
              <div class="field"><label>Join Date</label><input class="inp" type="date" id="f-joindate"/></div>
            </div>
            <div class="field"><label>Notes</label><textarea class="inp" id="f-notes" rows="2" placeholder="Any additional notes…"></textarea></div>
            <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:8px">
              <button class="btn-dark" onclick="showMemView('dir')">Cancel</button>
              <button class="btn-gold" onclick="submitMember()" id="form-submit-btn">Register Member</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="overlay" id="mem-modal">
      <div class="modal">
        <div class="modal-head"><div id="modal-avatar" style="width:54px;height:54px;border-radius:50%;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-weight:700;font-size:18px;color:#fff"></div><div style="margin-left:11px;flex:1"><div id="modal-name" style="font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:#f0e8d8"></div><div id="modal-type" style="font-size:11px;color:#d4956a;margin-top:2px"></div></div><button class="modal-close" onclick="closeMemModal()">×</button></div>
        <div class="modal-body"><div class="detail-grid" id="modal-details"></div><div id="modal-notes"></div><div class="modal-actions" id="modal-actions"></div></div>
      </div>
    </div>
  </div>

  <!-- ══ ATTENDANCE ══ -->
  <div id="page-attendance" class="page">
    <div class="page-wrap">
      <div class="mod-header"><div><div class="mod-tag">Tracking</div><div class="mod-title">Attendance</div></div></div>
      <div class="session-box">
        <div class="session-field"><label>Service</label><div class="sel-wrap"><select class="inp" id="att-service" onchange="refreshAtt()"><option>Sunday Morning Service</option><option>Sunday Evening Service</option><option>Wednesday Bible Study</option><option>Friday Prayer Meeting</option></select></div></div>
        <div class="session-field"><label>Date</label><input class="inp" type="date" id="att-date" onchange="refreshAtt()"/></div>
        <div id="att-live" style="font-size:12px;color:#5a4e42;padding-bottom:10px">—</div>
      </div>
      <div class="sub-tabs">
        <button class="sub-tab active" id="tab-mark" onclick="showAttTab('mark')">Mark Attendance</button>
        <button class="sub-tab" id="tab-report" onclick="showAttTab('report')">Attendance Report</button>
      </div>
      <div id="att-mark-view">
        <div class="filters-row">
          <input class="inp" type="search" id="att-search" placeholder="Search member…" oninput="renderAttList()" style="flex:1;min-width:150px"/>
          <button class="bulk-btn" onclick="attMarkAll('present')">✓ All Present</button>
          <button class="bulk-btn" onclick="attMarkAll('absent')">✗ All Absent</button>
          <button class="bulk-btn" onclick="attMarkAll(null)">↺ Clear</button>
        </div>
        <div id="att-list"></div>
        <div class="stats-row" id="att-stats" style="margin-top:16px"></div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px;flex-wrap:wrap">
          <button class="btn-sms" onclick="smsAbsent()">📱 SMS Absent Members</button>
          <button class="btn-gold" onclick="showAttTab('report')">View Report →</button>
        </div>
      </div>
      <div id="att-report-view" style="display:none">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:8px">
          <div><div style="font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:#f0e8d8">Attendance Report</div><div id="report-sub" style="font-size:12px;color:#5a4e42;margin-top:3px"></div></div>
          <div style="display:flex;gap:7px;flex-wrap:wrap"><button class="btn-sms" onclick="smsAbsent()">📱 SMS Absent</button><button class="btn-gold" onclick="printReport()">🖨 Print</button></div>
        </div>
        <div class="stats-row" id="report-stats" style="margin-bottom:16px"></div>
        <div style="background:rgba(224,112,112,.05);border:1px solid rgba(224,112,112,.14);border-radius:11px;overflow:hidden;margin-bottom:12px">
          <div style="padding:11px 16px;border-bottom:1px solid rgba(224,112,112,.12);background:rgba(224,112,112,.08);display:flex;align-items:center;justify-content:space-between"><span style="font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#e07070;font-weight:600">✗ Absent Members</span><span class="badge badge-red" id="absent-badge">0</span></div>
          <div id="absent-table"></div>
        </div>
        <div style="background:rgba(126,170,146,.05);border:1px solid rgba(126,170,146,.14);border-radius:11px;overflow:hidden">
          <div style="padding:11px 16px;border-bottom:1px solid rgba(126,170,146,.12);background:rgba(126,170,146,.08);display:flex;align-items:center;justify-content:space-between"><span style="font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#7eaa92;font-weight:600">✓ Present Members</span><span class="badge badge-green" id="present-badge">0</span></div>
          <div id="present-table"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══ SMS ══ -->
  <div id="page-sms" class="page">
    <div class="page-wrap">
      <div class="mod-header"><div><div class="mod-tag">Communication</div><div class="mod-title">BulkSMS Center</div></div></div>
      <div class="card" style="margin-bottom:16px">
        <div class="card-head"><span class="card-title">⚙ BulkSMS API Configuration</span><span class="badge badge-gold" id="sms-api-status">Not Configured</span></div>
        <div class="card-body">
          <div class="grid3">
            <div class="field"><label>API Token / Username</label><input class="inp" type="text" id="sms-api-token" placeholder="BulkSMS API token" oninput="saveSmsConfig()"/></div>
            <div class="field"><label>API Secret / Password</label><input class="inp" type="password" id="sms-api-secret" placeholder="BulkSMS password" oninput="saveSmsConfig()"/></div>
            <div class="field"><label>Sender ID</label><input class="inp" type="text" id="sms-sender" placeholder="e.g. CACI O6 Assembly" oninput="saveSmsConfig()"/></div>
          </div>
          <p style="font-size:10px;color:#4a3e42;margin-top:-6px">Get credentials at <strong style="color:#6aabee">bulksms.com</strong> — API Token &amp; Secret from your account settings. Without credentials, SMS will be simulated.</p>
        </div>
      </div>
      <div class="sub-tabs">
        <button class="sub-tab active" id="sms-tab-compose" onclick="showSmsTab('compose')">✏ Compose</button>
        <button class="sub-tab" id="sms-tab-templates" onclick="showSmsTab('templates')">📋 Templates</button>
        <button class="sub-tab" id="sms-tab-log" onclick="showSmsTab('log')">📊 Sent Log</button>
      </div>
      <div id="sms-compose">
        <div style="display:grid;grid-template-columns:1fr 1.4fr;gap:14px">
          <div class="card">
            <div class="card-head"><span class="card-title">Recipients</span><span class="badge badge-blue" id="sms-recip-count">0 selected</span></div>
            <div class="card-body">
              <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:12px">
                <button onclick="selectSmsGroup('all')" class="bulk-btn" style="text-align:left;padding:9px 12px">👥 All Active Members</button>
                <button onclick="selectSmsGroup('absent')" class="bulk-btn" style="text-align:left;padding:9px 12px">✗ Last Absent Members</button>
                <button onclick="selectSmsGroup('birthday')" class="bulk-btn" style="text-align:left;padding:9px 12px">🎂 Birthday This Week</button>
                <button onclick="selectSmsGroup('elders')" class="bulk-btn" style="text-align:left;padding:9px 12px">⛪ Elders &amp; Deacons</button>
                <button onclick="selectSmsGroup('none')" class="bulk-btn" style="text-align:left;padding:9px 12px;color:#4a3e42">✕ Clear Selection</button>
              </div>
              <div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#4a3e42;margin-bottom:7px">Or pick individually</div>
              <input class="inp" type="search" id="sms-member-search" placeholder="Search member…" oninput="renderSmsMembers()" style="margin-bottom:8px;padding:8px 12px;font-size:12px"/>
              <div id="sms-member-list" style="max-height:200px;overflow-y:auto;display:flex;flex-direction:column;gap:4px"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span class="card-title">Message</span></div>
            <div class="card-body">
              <div class="field"><label>Message Text</label><textarea class="inp" id="sms-msg" rows="5" placeholder="Type your message here…" oninput="updateCharCount()"></textarea><div style="font-size:10px;color:#4a3e42;text-align:right;margin-top:3px"><span id="sms-chars">0</span>/160 chars · <span id="sms-pages">1</span> SMS</div></div>
              <div id="sms-chips" style="margin-bottom:10px;min-height:24px"></div>
              <div style="display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;align-items:center">
                <span style="font-size:11px;color:#5a4e42"><span id="sms-send-count">0</span> recipients</span>
                <button class="btn-dark" onclick="previewSms()" style="padding:7px 14px">👁 Preview</button>
                <button class="btn-sms" onclick="sendSms()" id="sms-send-btn">📱 Send SMS</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="sms-templates" style="display:none"><div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px" id="sms-tpl-list"></div></div>
      <div id="sms-log" style="display:none">
        <div class="card"><div class="card-head"><span class="card-title">Sent Messages</span><span class="badge badge-blue" id="log-count">0 sent</span></div><div id="sms-log-body"><div class="empty-state" style="padding:36px"><div class="empty-icon">📱</div><p style="font-size:12px">No messages sent yet.</p></div></div></div>
      </div>
    </div>
  </div>

  <!-- ══ BIRTHDAYS ══ -->
  <div id="page-birthdays" class="page">
    <div class="page-wrap">
      <div class="mod-header"><div><div class="mod-tag">Reminders</div><div class="mod-title">Birthdays &amp; Anniversaries</div></div><button class="btn-sms" onclick="sendBirthdaySMS()" style="margin-top:8px">📱 SMS Birthday Members</button></div>
      <div class="stats-row" id="bday-stats"></div>
      <div class="tab-pills" id="bday-pills">
        <button class="tab-pill active" onclick="setBdayFilter('all',this)">All</button>
        <button class="tab-pill" onclick="setBdayFilter('today',this)">🎉 Today</button>
        <button class="tab-pill" onclick="setBdayFilter('week',this)">This Week</button>
        <button class="tab-pill" onclick="setBdayFilter('month',this)">This Month</button>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:16px">
        <div><div style="font-size:9px;text-transform:uppercase;letter-spacing:2px;color:#d4956a;margin-bottom:10px">🎂 Birthdays</div><div id="bday-list"></div></div>
        <div><div style="font-size:9px;text-transform:uppercase;letter-spacing:2px;color:#8fa8d4;margin-bottom:10px">✝ Church Anniversaries</div><div id="anniv-list"></div></div>
      </div>
    </div>
  </div>

  <!-- ══ VISITORS ══ -->
  <div id="page-visitors" class="page">
    <div class="page-wrap">
      <div class="mod-header"><div><div class="mod-tag">Guest Log</div><div class="mod-title">Visitor Log</div></div><div id="vis-hdr-btn" style="margin-top:8px"></div></div>
      <div class="stats-row" id="vis-stats"></div>
      <div class="filters-row">
        <input class="inp" type="search" id="vis-search" placeholder="Search visitors…" oninput="renderVisitors()" style="flex:1;min-width:150px"/>
        <div class="sel-wrap" style="min-width:130px"><select class="inp" id="vis-filter" onchange="renderVisitors()"><option value="">All Follow-ups</option><option value="New">New</option><option value="Contacted">Contacted</option><option value="Returning">Returning</option></select></div>
      </div>
      <div id="vis-list"></div>
      <div id="vis-empty" style="display:none"><div class="empty-state"><div class="empty-icon">🙋</div><h3 style="font-size:17px;margin-bottom:7px;color:#6a5e52">No visitors logged yet</h3><p style="font-size:12px;margin-bottom:16px">Start tracking guests and follow-ups.</p><button class="btn-gold" onclick="openVisitorForm()">+ Log First Visitor</button></div></div>
    </div>
    <div class="overlay" id="vis-modal">
      <div class="modal">
        <div class="modal-head"><div style="font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:#f0e8d8;flex:1" id="vis-form-title">Log New Visitor</div><button class="modal-close" onclick="closeVisModal()">×</button></div>
        <div class="modal-body">
          <div class="grid2"><div class="field"><label>First Name <span style="color:#d4956a">*</span></label><input class="inp" type="text" id="vf-first" placeholder="First name"/><div class="field-err" id="ve-first"></div></div><div class="field"><label>Last Name <span style="color:#d4956a">*</span></label><input class="inp" type="text" id="vf-last" placeholder="Last name"/><div class="field-err" id="ve-last"></div></div></div>
          <div class="grid2"><div class="field"><label>Phone</label><input class="inp" type="tel" id="vf-phone" placeholder="055-000-0000"/></div><div class="field"><label>Date of Visit <span style="color:#d4956a">*</span></label><input class="inp" type="date" id="vf-date"/></div></div>
          <div class="grid2"><div class="field"><label>Service Attended</label><div class="sel-wrap"><select class="inp" id="vf-service"><option>Sunday Morning Service</option><option>Sunday Evening Service</option><option>Wednesday Bible Study</option><option>Friday Prayer Meeting</option></select></div></div><div class="field"><label>Follow-up Status</label><div class="sel-wrap"><select class="inp" id="vf-status"><option value="New">New</option><option value="Contacted">Contacted</option><option value="Returning">Returning</option></select></div></div></div>
          <div class="field"><label>Invited By</label><input class="inp" type="text" id="vf-invited" placeholder="Member who invited them"/></div>
          <div class="field"><label>Notes</label><textarea class="inp" id="vf-notes" rows="2" placeholder="Follow-up notes…"></textarea></div>
          <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px"><button class="btn-dark" onclick="closeVisModal()">Cancel</button><button class="btn-gold" onclick="submitVisitor()" id="vis-submit-btn">Log Visitor</button></div>
        </div>
      </div>
    </div>
    <div class="overlay" id="vis-detail-modal">
      <div class="modal">
        <div class="modal-head"><div style="width:44px;height:44px;border-radius:50%;background:rgba(143,168,212,.2);border:1px solid rgba(143,168,212,.3);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0">🙋</div><div style="margin-left:11px;flex:1"><div id="vd-name" style="font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:#f0e8d8"></div><div id="vd-status-badge" style="margin-top:3px"></div></div><button class="modal-close" onclick="closeVisDetail()">×</button></div>
        <div class="modal-body"><div class="detail-grid" id="vd-details"></div><div id="vd-notes"></div><div class="modal-actions" id="vd-actions"></div></div>
      </div>
    </div>
  </div>

  <!-- SMS Preview Modal -->
  <div class="overlay" id="sms-preview-modal">
    <div class="modal" style="max-width:420px">
      <div class="modal-head"><div style="font-size:17px;font-weight:700;color:#f0e8d8;flex:1;font-family:'Playfair Display',serif">📱 SMS Preview</div><button class="modal-close" onclick="document.getElementById('sms-preview-modal').classList.remove('open')">×</button></div>
      <div class="modal-body">
        <div style="background:rgba(74,144,217,.08);border:1px solid rgba(74,144,217,.14);border-radius:9px;padding:13px;margin-bottom:12px;font-size:12px;color:#c0d4f0;line-height:1.6;white-space:pre-wrap" id="preview-msg"></div>
        <div id="preview-recips" style="margin-bottom:12px"></div>
        <div style="font-size:11px;color:#4a3e42;margin-bottom:12px" id="preview-cost"></div>
        <div style="display:flex;gap:8px;justify-content:flex-end">
          <button class="btn-dark" onclick="document.getElementById('sms-preview-modal').classList.remove('open')">Cancel</button>
          <button class="btn-sms" onclick="document.getElementById('sms-preview-modal').classList.remove('open');sendSms()">Confirm &amp; Send</button>
        </div>
      </div>
    </div>
  </div>


  <!-- ══ SETTINGS ══ -->
  <div id="page-settings" class="page">
    <div class="page-wrap">
      <div class="mod-header"><div><div class="mod-tag">System</div><div class="mod-title">Settings</div></div></div>

      <!-- Supabase Config -->
      <div class="card" style="margin-bottom:18px">
        <div class="card-head"><span class="card-title">🗄️ Supabase Database (Multi-device Sync)</span><span class="badge" id="sb-status-badge" style="background:rgba(255,255,255,.06);color:#888;border:1px solid rgba(255,255,255,.1)">Not Connected</span></div>
        <div class="card-body">
          <p style="font-size:12px;color:#5a4e42;margin-bottom:16px;line-height:1.6">Connect your Supabase project to sync all members, visitors, attendance and SMS logs across every device in real time. Data will never be lost when you log out.</p>
          <div class="grid2">
            <div class="field"><label>Supabase Project URL</label><input class="inp" type="text" id="sb-url" placeholder="https://xxxx.supabase.co" oninput="checkSbConfig()"/></div>
            <div class="field"><label>Supabase Anon Public Key</label><input class="inp" type="text" id="sb-key" placeholder="eyJhbGciOiJIUzI1NiIs…" oninput="checkSbConfig()"/></div>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:4px">
            <button class="btn-sms" onclick="connectSupabase()" id="sb-connect-btn">🔌 Connect & Sync</button>
            <button class="btn-dark" onclick="testSupabaseConnection()">🧪 Test Connection</button>
            <button class="btn-red" onclick="disconnectSupabase()" id="sb-disconnect-btn" style="display:none">Disconnect</button>
          </div>
          <div id="sb-test-result" style="margin-top:12px;font-size:12px;display:none;padding:10px 14px;border-radius:8px"></div>
          <div style="margin-top:14px;padding:12px 14px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);border-radius:8px">
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#d4956a;margin-bottom:8px">Setup Instructions</div>
            <ol style="font-size:12px;color:#6a5e52;line-height:1.9;padding-left:18px">
              <li>Go to <strong style="color:#6aabee">supabase.com</strong> → create a free account</li>
              <li>Create a new project (name it <em>graceflow</em>)</li>
              <li>Go to <strong>SQL Editor</strong> and run the setup SQL below</li>
              <li>Go to <strong>Project Settings → API</strong> → copy URL and anon key</li>
              <li>Paste them above and click <strong>Connect &amp; Sync</strong></li>
            </ol>
          </div>
          <div style="margin-top:14px">
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#d4956a;margin-bottom:8px">SQL to run in Supabase SQL Editor</div>
            <pre style="background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:14px;font-size:11px;color:#8fa8d4;overflow-x:auto;line-height:1.6;white-space:pre-wrap">create table if not exists members (
  id bigint primary key,
  data jsonb not null,
  created_at timestamptz default now()
);
create table if not exists visitors (
  id bigint primary key,
  data jsonb not null,
  created_at timestamptz default now()
);
create table if not exists attendance (
  session_key text primary key,
  data jsonb not null,
  updated_at timestamptz default now()
);
create table if not exists sms_log (
  id bigserial primary key,
  data jsonb not null,
  created_at timestamptz default now()
);

-- Allow public access (anon key)
alter table members enable row level security;
alter table visitors enable row level security;
alter table attendance enable row level security;
alter table sms_log enable row level security;

create policy "Allow all" on members for all using (true) with check (true);
create policy "Allow all" on visitors for all using (true) with check (true);
create policy "Allow all" on attendance for all using (true) with check (true);
create policy "Allow all" on sms_log for all using (true) with check (true);</pre>
            <button onclick="copySetupSQL()" class="btn-dark" style="margin-top:8px;padding:7px 14px;font-size:11px">📋 Copy SQL</button>
          </div>
        </div>
      </div>

      <!-- BulkSMS Config moved here -->
      <div class="card" style="margin-bottom:18px">
        <div class="card-head"><span class="card-title">📱 BulkSMS Configuration</span><span class="badge badge-gold" id="sms-api-status2">Not Configured</span></div>
        <div class="card-body">
          <div class="grid3">
            <div class="field"><label>API Token / Username</label><input class="inp" type="text" id="sms-api-token2" placeholder="BulkSMS API token" oninput="syncSmsConfig()"/></div>
            <div class="field"><label>API Secret / Password</label><input class="inp" type="password" id="sms-api-secret2" placeholder="BulkSMS password" oninput="syncSmsConfig()"/></div>
            <div class="field"><label>Sender ID</label><input class="inp" type="text" id="sms-sender2" placeholder="e.g. CACI O6 Assembly" oninput="syncSmsConfig()"/></div>
          </div>
          <p style="font-size:11px;color:#4a3e42">Get credentials at <strong style="color:#6aabee">bulksms.com</strong> → Account Settings → API Tokens</p>
        </div>
      </div>

      <!-- Data Management -->
      <div class="card">
        <div class="card-head"><span class="card-title">📊 CSV Export</span><span class="badge badge-blue">Download spreadsheet-ready files</span></div>
        <div class="card-body">
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin-bottom:14px">

            <!-- Export 1: Members -->
            <div style="background:rgba(139,92,246,.07);border:1px solid rgba(139,92,246,.18);border-radius:10px;padding:14px">
              <div style="font-size:18px;margin-bottom:7px">👥</div>
              <div style="font-size:13px;font-weight:600;color:#c4b5fd;margin-bottom:4px">Members</div>
              <div style="font-size:11px;color:#6a5e92;margin-bottom:12px;line-height:1.4">Name, phone, gender, position, type, status, family, join date, address</div>
              <button class="btn-gold" onclick="exportCSV('members')" style="width:100%;padding:8px;font-size:11px">⬇ Download CSV</button>
            </div>

            <!-- Export 2: Visitors -->
            <div style="background:rgba(99,102,241,.07);border:1px solid rgba(99,102,241,.18);border-radius:10px;padding:14px">
              <div style="font-size:18px;margin-bottom:7px">🙋</div>
              <div style="font-size:13px;font-weight:600;color:#a5b4fc;margin-bottom:4px">Visitors</div>
              <div style="font-size:11px;color:#6a5e92;margin-bottom:12px;line-height:1.4">Name, phone, date, service, invited by, follow-up status, notes</div>
              <button class="btn-gold" onclick="exportCSV('visitors')" style="width:100%;padding:8px;font-size:11px">⬇ Download CSV</button>
            </div>

            <!-- Export 3: Attendance -->
            <div style="background:rgba(16,185,129,.06);border:1px solid rgba(16,185,129,.18);border-radius:10px;padding:14px">
              <div style="font-size:18px;margin-bottom:7px">✅</div>
              <div style="font-size:13px;font-weight:600;color:#6ee7b7;margin-bottom:4px">Attendance</div>
              <div style="font-size:11px;color:#6a5e92;margin-bottom:12px;line-height:1.4">Date, service, member name, status (present/absent) per session</div>
              <button class="btn-gold" onclick="exportCSV('attendance')" style="width:100%;padding:8px;font-size:11px">⬇ Download CSV</button>
            </div>

            <!-- Export 4: SMS Log -->
            <div style="background:rgba(6,182,212,.06);border:1px solid rgba(6,182,212,.18);border-radius:10px;padding:14px">
              <div style="font-size:18px;margin-bottom:7px">📱</div>
              <div style="font-size:13px;font-weight:600;color:#67e8f9;margin-bottom:4px">SMS Log</div>
              <div style="font-size:11px;color:#6a5e92;margin-bottom:12px;line-height:1.4">Time sent, recipient count, message preview, send status</div>
              <button class="btn-gold" onclick="exportCSV('smslog')" style="width:100%;padding:8px;font-size:11px">⬇ Download CSV</button>
            </div>

            <!-- Export 5: All Data -->
            <div style="background:linear-gradient(135deg,rgba(139,92,246,.1),rgba(6,182,212,.07));border:1px solid rgba(139,92,246,.25);border-radius:10px;padding:14px;grid-column:span 1">
              <div style="font-size:18px;margin-bottom:7px">📦</div>
              <div style="font-size:13px;font-weight:600;color:#e0d4ff;margin-bottom:4px">All Data Combined</div>
              <div style="font-size:11px;color:#6a5e92;margin-bottom:12px;line-height:1.4">Members + Visitors + Attendance in one ZIP-style download (3 CSV files)</div>
              <button class="btn-sms" onclick="exportAllCSV()" style="width:100%;padding:8px;font-size:11px;justify-content:center">⬇ Download All (3 CSVs)</button>
            </div>

          </div>

          <div id="export-status" style="display:none;padding:10px 14px;border-radius:8px;font-size:12px;margin-bottom:12px"></div>

          <!-- JSON + Clear -->
          <div style="border-top:1px solid rgba(139,92,246,.1);padding-top:12px;display:flex;gap:10px;flex-wrap:wrap">
            <button class="btn-dark" onclick="exportData()" style="padding:8px 14px;font-size:11px">📄 Export JSON Backup</button>
            <button class="btn-red" onclick="confirmClearData()" style="padding:8px 14px;font-size:11px">🗑 Clear All Local Data</button>
          </div>
          <div id="clear-confirm" style="display:none;margin-top:12px;padding:12px 14px;background:rgba(224,112,112,.08);border:1px solid rgba(224,112,112,.2);border-radius:8px">
            <div style="font-size:13px;color:#e07070;margin-bottom:10px">⚠ This will delete all data from this device. Are you sure?</div>
            <div style="display:flex;gap:8px">
              <button class="btn-dark" onclick="document.getElementById('clear-confirm').style.display='none'">Cancel</button>
              <button class="btn-red" onclick="clearAllData()">Yes, Clear Everything</button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

</div><!-- /main-content -->
</div><!-- /app-shell -->

<script>
// ════════ STATE ════════
const USERS=[
  {username:'admin',    password:'grace2026', role:'Administrator', name:'Bro Joseph',  canEdit:true,  canDelete:true},
  {username:'pastor',   password:'pastor123',  role:'Pastor',        name:'Rev Peter',   canEdit:true,  canDelete:false},
  {username:'secretary',password:'church123',  role:'Secretary',     name:'Elder Odame', canEdit:false, canDelete:false},
  {username:'deacon',   password:'deacon123',  role:'Deacon',        name:'Deacon',      canEdit:false, canDelete:false},
];

// ── ROLE HELPERS ──
const isAdmin    = ()=> currentUser && currentUser.canDelete === true;
const canEdit    = ()=> currentUser && (currentUser.canEdit === true || currentUser.canDelete === true);
const canDelete  = ()=> currentUser && currentUser.canDelete === true;

const AVC=['#d4956a','#7eaa92','#8fa8d4','#c47e8a','#a08dd4','#6abbd4','#d4c16a','#7e9eaa'];
const SMS_TEMPLATES=[
  {id:1,name:'Welcome New Member',icon:'🎉',msg:'Welcome to CACI O6 Assembly! We are delighted to have you as part of our family. May God bless you abundantly as you grow with us.'},
  {id:2,name:'Sunday Service Reminder',icon:'⛪',msg:'Dear [Name], this is a reminder that our Sunday Morning Service starts at 9:00 AM tomorrow. We look forward to worshipping with you. God bless!'},
  {id:3,name:'Absent Member Follow-up',icon:'🙏',msg:'Dear [Name], we missed you at our last service. We are keeping you in our prayers. Please reach out if there is anything we can do for you. God bless!'},
  {id:4,name:'Birthday Wishes',icon:'🎂',msg:'Happy Birthday [Name]! On behalf of CACI O6 Assembly, we celebrate you on this special day. May God continue to bless and guide you. Many happy returns!'},
  {id:5,name:'Special Announcement',icon:'📢',msg:'Dear church family, we have an important announcement. Please check with the church office for more details. God bless!'},
  {id:6,name:'Meeting Reminder',icon:'📅',msg:'Dear [Name], this is a reminder that there is an important church meeting scheduled. Please make every effort to attend. Thank you and God bless!'},
];
let _nid=20,_vid=100,members=[],visitors=[],attData={},smsLog=[],activityLog=[];
let editingId=null,editingVid=null,modalMemberId=null,detailVid=null;
let confirmDel=false,confirmDelVis=false,formPhoto='';
let smsSelected=new Set(),bdayFilter='all',currentUser=null,sidebarOpen=true;
const genId=()=>_nid++;


// ════════ SUPABASE ════════
let supabaseClient = null;
let supabaseConnected = false;

function getSbCreds(){
  return {
    url: localStorage.getItem('gf_sb_url')||'',
    key: localStorage.getItem('gf_sb_key')||''
  };
}

function initSupabase(){
  const {url, key} = getSbCreds();
  if(!url || !key){ supabaseConnected=false; return false; }
  try{
    // Use fetch-based client to avoid DataCloneError
    supabaseClient = {
      _url: url,
      _key: key,
      from: function(table){
        var base = url + '/rest/v1/' + table;
        var headers = {'apikey': key, 'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json', 'Prefer': 'return=representation'};
        return {
          select: function(cols, opts){
            var q = base + '?select=' + (cols||'*');
            if(opts && opts.count==='exact') q += '&limit=1';
            return {
              order: function(col, o){ q += '&order=' + col + (o&&o.ascending===false?'.desc':''); return this; },
              limit: function(n){ q += '&limit=' + n; return this; },
              eq: function(col, val){ q += '&' + col + '=eq.' + val; return this; },
              head: true,
              then: function(fn){ return fetch(q, {headers: headers}).then(function(r){ return r.json(); }).then(function(data){ return fn({data:data,error:null}); }).catch(function(e){ return fn({data:null,error:e}); }); }
            };
          },
          upsert: function(rows, opts){
            var arr = Array.isArray(rows) ? rows : [rows];
            var h = Object.assign({}, headers, {'Prefer': 'resolution=merge-duplicates,return=minimal'});
            return fetch(base, {method:'POST', headers:h, body:JSON.stringify(arr)}).then(function(r){ return {error: r.ok?null:{message:r.statusText}}; }).catch(function(e){ return {error:e}; });
          },
          insert: function(rows){
            var arr = Array.isArray(rows) ? rows : [rows];
            return fetch(base, {method:'POST', headers:headers, body:JSON.stringify(arr)}).then(function(r){ return {error: r.ok?null:{message:r.statusText}}; }).catch(function(e){ return {error:e}; });
          },
          delete: function(){
            return { eq: function(col, val){ return fetch(base+'?'+col+'=eq.'+val, {method:'DELETE', headers:headers}).then(function(r){ return {error: r.ok?null:{message:r.statusText}}; }).catch(function(e){ return {error:e}; }); }};
          }
        };
      }
    };
    supabaseConnected = true;
    localStorage.setItem('gf_sb_url', url);
    localStorage.setItem('gf_sb_key', key);
    updateSbUI(true);
    return true;
  }catch(e){
    supabaseConnected=false;
    console.warn('Supabase init failed:', e);
    return false;
  }
}

function updateSbUI(connected){
  const badge = document.getElementById('sb-status-badge');
  const connectBtn = document.getElementById('sb-connect-btn');
  const disconnectBtn = document.getElementById('sb-disconnect-btn');
  if(badge){
    badge.textContent = connected ? 'Connected ✓' : 'Not Connected';
    badge.className = connected ? 'badge badge-green' : 'badge badge-grey';
  }
  if(connectBtn) connectBtn.style.display = connected ? 'none' : 'inline-flex';
  if(disconnectBtn) disconnectBtn.style.display = connected ? 'inline-block' : 'none';
}

function checkSbConfig(){
  const url = (document.getElementById('sb-url')||{}).value||'';
  const key = (document.getElementById('sb-key')||{}).value||'';
  const btn = document.getElementById('sb-connect-btn');
  if(btn) btn.textContent = (url && key) ? '🔌 Connect & Sync' : '🔌 Connect & Sync';
}

async function connectSupabase(){
  const url = (document.getElementById('sb-url')||{}).value.trim();
  const key = (document.getElementById('sb-key')||{}).value.trim();
  if(!url || !key){ showToast('Please enter both URL and API key.','red'); return; }
  localStorage.setItem('gf_sb_url', url);
  localStorage.setItem('gf_sb_key', key);
  const ok = initSupabase();
  if(!ok){ showToast('Failed to initialise Supabase client.','red'); return; }
  // Test connection
  const result = await testConnection();
  if(result.ok){
    showToast('Supabase connected! Syncing data…');
    await pushAllToSupabase();
    await pullFromSupabase();
    renderDashboard();
  } else {
    showToast('Connection failed: ' + result.error, 'red');
    supabaseConnected = false;
    updateSbUI(false);
  }
}

async function testConnection(){
  try{
    var testRes = await fetch(supabaseClient._url+'/rest/v1/members?select=id&limit=1', {headers:{'apikey':supabaseClient._key,'Authorization':'Bearer '+supabaseClient._key}});
    var error = testRes.ok ? null : {message: testRes.statusText};
    if(error) return { ok: false, error: error.message };
    return { ok: true };
  }catch(e){ return { ok: false, error: e.message }; }
}

async function testSupabaseConnection(){
  const resultEl = document.getElementById('sb-test-result');
  if(!supabaseConnected){ 
    if(resultEl){ resultEl.style.display='block'; resultEl.style.background='rgba(224,112,112,.1)'; resultEl.style.border='1px solid rgba(224,112,112,.2)'; resultEl.style.color='#e07070'; resultEl.textContent='Not connected — enter credentials and click Connect first.'; }
    return; 
  }
  if(resultEl){ resultEl.style.display='block'; resultEl.textContent='Testing…'; resultEl.style.color='#8fa8d4'; }
  const result = await testConnection();
  if(resultEl){
    if(result.ok){ resultEl.style.background='rgba(126,170,146,.1)'; resultEl.style.border='1px solid rgba(126,170,146,.2)'; resultEl.style.color='#7eaa92'; resultEl.textContent='✓ Connection successful! Tables found and accessible.'; }
    else{ resultEl.style.background='rgba(224,112,112,.1)'; resultEl.style.border='1px solid rgba(224,112,112,.2)'; resultEl.style.color='#e07070'; resultEl.textContent='✗ Error: ' + result.error; }
  }
}

function disconnectSupabase(){
  supabaseClient = null; supabaseConnected = false;
  localStorage.removeItem('gf_sb_url'); localStorage.removeItem('gf_sb_key');
  const urlEl=document.getElementById('sb-url'); if(urlEl) urlEl.value='';
  const keyEl=document.getElementById('sb-key'); if(keyEl) keyEl.value='';
  updateSbUI(false);
  showToast('Supabase disconnected. Using local storage only.');
}

// ── Push all local data to Supabase ──
async function pushAllToSupabase(){
  if(!supabaseConnected || !supabaseClient) return;
  try{
    // Members
    if(members.length){
      const mRows = members.map(m => ({id: m.id, data: m}));
      await supabaseClient.from('members').upsert(mRows, {onConflict:'id'});
    }
    // Visitors
    if(visitors.length){
      const vRows = visitors.map(v => ({id: v.id, data: v}));
      await supabaseClient.from('visitors').upsert(vRows, {onConflict:'id'});
    }
    // Attendance
    const attKeys = Object.keys(attData);
    if(attKeys.length){
      const aRows = attKeys.map(k => ({session_key: k, data: attData[k]}));
      await supabaseClient.from('attendance').upsert(aRows, {onConflict:'session_key'});
    }
    // SMS Log
    if(smsLog.length){
      const sRows = smsLog.map(s => ({data: s}));
      // Only push if log is fresh — skip if already have rows
      const {count} = await supabaseClient.from('sms_log').select('*', {count:'exact', head:true});
      if(!count || count === 0){
        await supabaseClient.from('sms_log').insert(sRows);
      }
    }
  }catch(e){ console.warn('pushAllToSupabase error:', e); }
}

// ── Pull data from Supabase ──
async function pullFromSupabase(){
  if(!supabaseConnected || !supabaseClient) return;
  try{
    var sbUrl = supabaseClient._url;
    var sbKey = supabaseClient._key;
    var h = {'apikey': sbKey, 'Authorization': 'Bearer ' + sbKey, 'Content-Type': 'application/json'};

    var mRes = await fetch(sbUrl+'/rest/v1/members?select=id,data&order=created_at.desc', {headers:h});
    var mData = await mRes.json();
    if(Array.isArray(mData) && mData.length){ members = mData.map(function(r){return r.data;}); _nid = Math.max(_nid, ...members.map(function(m){return m.id+1;})); }

    var vRes = await fetch(sbUrl+'/rest/v1/visitors?select=id,data&order=created_at.desc', {headers:h});
    var vData = await vRes.json();
    if(Array.isArray(vData) && vData.length){ visitors = vData.map(function(r){return r.data;}); _vid = Math.max(_vid, ...visitors.map(function(v){return v.id+1;})); }

    var aRes = await fetch(sbUrl+'/rest/v1/attendance?select=session_key,data', {headers:h});
    var aData = await aRes.json();
    if(Array.isArray(aData) && aData.length){ attData = {}; aData.forEach(function(r){ attData[r.session_key] = r.data; }); }

    var sRes = await fetch(sbUrl+'/rest/v1/sms_log?select=data&order=created_at.desc&limit=100', {headers:h});
    var sData = await sRes.json();
    if(Array.isArray(sData) && sData.length){ smsLog = sData.map(function(r){return r.data;}); }

    saveData(); // sync to localStorage too
    renderDashboard(); // update all widgets
  }catch(e){ console.warn('pullFromSupabase error:', e); }
}

// ── Upsert a single member ──
async function sbUpsertMember(m){
  if(!supabaseConnected || !supabaseClient) return;
  try{ await supabaseClient.from('members').upsert({id:m.id, data:m},{onConflict:'id'}); }
  catch(e){ console.warn('sbUpsertMember error:', e); }
}

// ── Delete a single member ──
async function sbDeleteMember(id){
  if(!supabaseConnected || !supabaseClient) return;
  try{ await supabaseClient.from('members').delete().eq('id', id); }
  catch(e){ console.warn('sbDeleteMember error:', e); }
}

