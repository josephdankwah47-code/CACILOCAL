function printVisitors(){
  var list = visitors.map(function(v){ return {firstName:v.firstName||'',lastName:v.lastName||'',gender:v.gender||'',dob:v.dob||'',dayBorn:'',phone:v.phone||'',position:'Visitor',memberType:'Visitor'}; });
  var printContent = buildPrintHTML('Visitors', '#8fa8d4', list);
  var iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:800px;height:600px';
  document.body.appendChild(iframe);
  iframe.contentDocument.open();
  iframe.contentDocument.write(printContent);
