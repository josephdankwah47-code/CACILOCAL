  try{ await supabaseClient.from('visitors').delete().eq('id', id); }
  catch(e){ console.warn('sbDeleteVisitor error:', e); }
}

// ── Upsert attendance session ──
async function sbUpsertAttendance(key, data){
  if(!supabaseConnected || !supabaseClient) return;
  try{ await supabaseClient.from('attendance').upsert({session_key:key, data:data},{onConflict:'session_key'}); }
  catch(e){ console.warn('sbUpsertAttendance error:', e); }
}

// ── Insert SMS log entry ──
async function sbInsertSmsLog(entry){
  if(!supabaseConnected || !supabaseClient) return;
  try{ await supabaseClient.from('sms_log').insert({data:entry}); }
  catch(e){ console.warn('sbInsertSmsLog error:', e); }
}

// ── Settings helpers ──
function syncSmsConfig(){
  const token = (document.getElementById('sms-api-token2')||{}).value||'';
  const secret = (document.getElementById('sms-api-secret2')||{}).value||'';
  const sender = (document.getElementById('sms-sender2')||{}).value||'';
  const t1=document.getElementById('sms-api-token'); if(t1) t1.value=token;
  const s1=document.getElementById('sms-api-secret'); if(s1) s1.value=secret;
  const sn=document.getElementById('sms-sender'); if(sn) sn.value=sender;
  saveSmsConfig();
}
function saveSmsConfig(){
  const token=(document.getElementById('sms-api-token')||{}).value||'';
  const secret=(document.getElementById('sms-api-secret')||{}).value||'';
  const el=document.getElementById('sms-api-status');if(el){el.textContent=token&&secret?'Configured ✓':'Not Configured';el.className=token&&secret?'badge badge-green':'badge badge-gold';}
  const el2=document.getElementById('sms-api-status2');if(el2){el2.textContent=token&&secret?'Configured ✓':'Not Configured';el2.className=token&&secret?'badge badge-green':'badge badge-gold';}
  localStorage.setItem('gf_sms_token', token);
  localStorage.setItem('gf_sms_secret', secret);
  localStorage.setItem('gf_sms_sender', (document.getElementById('sms-sender')||{}).value||'');
}
function loadSmsConfig(){
  const token=localStorage.getItem('gf_sms_token')||'';
  const secret=localStorage.getItem('gf_sms_secret')||'';
  const sender=localStorage.getItem('gf_sms_sender')||'';
  ['sms-api-token','sms-api-token2'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=token;});
  ['sms-api-secret','sms-api-secret2'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=secret;});
  ['sms-sender','sms-sender2'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=sender;});
  saveSmsConfig();
}
function loadSbConfig(){
  const url=localStorage.getItem('gf_sb_url')||'';
  const key=localStorage.getItem('gf_sb_key')||'';
  const urlEl=document.getElementById('sb-url');if(urlEl)urlEl.value=url;
  const keyEl=document.getElementById('sb-key');if(keyEl)keyEl.value=key;
}
function copySetupSQL(){
  const sql=document.querySelector('pre').textContent;
  navigator.clipboard.writeText(sql).then(()=>showToast('SQL copied to clipboard!')).catch(()=>showToast('Copy failed — select and copy manually.','red'));
}
function exportData(){
  const data={members,visitors,attData,smsLog,exported:new Date().toISOString()};
  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='graceflow-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();
  showToast('Data exported successfully!');
}
function confirmClearData(){
  document.getElementById('clear-confirm').style.display='block';
}
function clearAllData(){
  members=[];visitors=[];attData={};smsLog=[];_nid=20;_vid=100;
  ['gf_members','gf_visitors','gf_attData','gf_smsLog','gf_nid','gf_vid'].forEach(k=>localStorage.removeItem(k));
  document.getElementById('clear-confirm').style.display='none';
  showToast('All local data cleared.');
  renderDashboard();
}
const PAGE_TITLES_EXT={settings:'Settings'};

// ════════ PERSISTENCE (localStorage) ════════
function saveData(){
  try{
    localStorage.setItem('gf_members', JSON.stringify(members));
    localStorage.setItem('gf_visitors', JSON.stringify(visitors));
    localStorage.setItem('gf_attData', JSON.stringify(attData));
    localStorage.setItem('gf_smsLog', JSON.stringify(smsLog));
    localStorage.setItem('gf_nid', String(_nid));
    localStorage.setItem('gf_vid', String(_vid));
  }catch(e){console.warn('CACI O6 Assembly: could not save data',e);}
}
function loadData(){
  try{
    const m=localStorage.getItem('gf_members');if(m)members=JSON.parse(m);
    const v=localStorage.getItem('gf_visitors');if(v)visitors=JSON.parse(v);
    const a=localStorage.getItem('gf_attData');if(a)attData=JSON.parse(a);
    const s=localStorage.getItem('gf_smsLog');if(s)smsLog=JSON.parse(s);
    const nid=localStorage.getItem('gf_nid');if(nid)_nid=parseInt(nid)||20;
    const vid=localStorage.getItem('gf_vid');if(vid)_vid=parseInt(vid)||100;
  }catch(e){console.warn('CACI O6 Assembly: could not load data',e);}
}
const genVid=()=>_vid++;
const todayStr=()=>new Date().toISOString().split('T')[0];
const avColor=id=>AVC[id%AVC.length];
const initials=m=>(m.firstName[0]+m.lastName[0]).toUpperCase();
const fmtDate=d=>d?new Date(d+'T00:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}):'—';
const fmtShort=d=>d?new Date(d+'T00:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}):'—';
function daysUntil(mmdd){
  var today=new Date(); var yr=today.getFullYear();
  var parts=mmdd.split('-'); var mo=parseInt(parts[0])-1; var dy=parseInt(parts[1]);
  var next=new Date(yr,mo,dy);
  if(next<today){next=new Date(yr+1,mo,dy);}
  var diff=Math.round((next-today)/(1000*60*60*24));
  return diff;
}
function dayPill(days){
  var txt=days===0?'Today':days===1?'Tomorrow':'In '+days+' days';
  var clr=days===0?'#d4956a':days<=3?'#c47e8a':'#5a6e8a';
  return '<span style="font-size:10px;background:'+clr+';color:#fff;padding:2px 8px;border-radius:20px">'+txt+'</span>';
}
const attKey=()=>`${(document.getElementById('att-date')||{}).value}__${(document.getElementById('att-service')||{}).value}`;
const getAtt=id=>(attData[attKey()]||{})[id]||null;
const setAtt=(id,s)=>{const k=attKey();if(!attData[k])attData[k]={};attData[k][id]=s;};
const bCls=s=>({Active:'badge-green',Inactive:'badge-grey',Transferred:'badge-gold'}[s]||'badge-grey');

// ════════ TOAST ════════
let _tt;
function showToast(msg,type='gold'){
  const t=document.getElementById('toast');
  t.textContent='✦ '+msg;
  t.style.borderColor=type==='red'?'rgba(224,112,112,.4)':'rgba(212,149,106,.4)';
  t.style.color=type==='red'?'#e07070':'#d4956a';
  t.style.display='block';
  clearTimeout(_tt);_tt=setTimeout(()=>t.style.display='none',3600);
}

// ════════ SIDEBAR ════════
function toggleSidebar(){
  sidebarOpen=!sidebarOpen;
  document.getElementById('sidebar').classList.toggle('collapsed',!sidebarOpen);
  document.getElementById('main-content').classList.toggle('full',!sidebarOpen);
}

// ════════ AUTH ════════
function doLogin(){
  const u=document.getElementById('l-user').value.trim(),p=document.getElementById('l-pass').value;
  const err=document.getElementById('login-err'),btn=document.getElementById('login-btn');
  err.style.display='none';
  if(!u||!p){err.textContent='⚠ Please enter both fields.';err.style.display='block';return;}
  btn.textContent='Signing in…';btn.disabled=true;
  setTimeout(()=>{
    const found=USERS.find(x=>x.username===u&&x.password===p);
    if(found){
      currentUser=found;
      loadData();
      document.getElementById('sb-name').textContent=found.name;
      // Auto-connect supabase if credentials saved, then pull data
      (async function(){
        if(!supabaseConnected){
          const url=localStorage.getItem('gf_sb_url');
          const key=localStorage.getItem('gf_sb_key');
          if(url&&key){ await initSupabase(url,key); }
        }
        if(supabaseConnected){
          try{ await pullFromSupabase(); }catch(e){ console.warn(e); }
        }
        renderDashboard();
      })();
      document.getElementById('sb-role').textContent=found.role+(found.canDelete?' · Full Access':found.canEdit?' · Can Edit':'· View Only');
      document.getElementById('sb-av').textContent=found.name[0];
      document.getElementById('login-screen').style.display='none';
      document.getElementById('app-shell').style.display='flex';
      const d=document.getElementById('att-date');if(d)d.value=todayStr();
      setTbDate();goPage('dashboard');
    } else {
      err.textContent='⚠ Invalid username or password.';err.style.display='block';
      btn.textContent='Sign In →';btn.disabled=false;
    }
  },800);
}
function togglePass(){const i=document.getElementById('l-pass');const e=document.getElementById('pass-eye');i.type=i.type==='password'?'text':'password';e.textContent=i.type==='password'?'👁':'🙈';}
function signOut(){
  // Keep data in localStorage — only reset session state
  currentUser=null;activityLog=[];smsSelected=new Set();
  document.getElementById('app-shell').style.display='none';
  document.getElementById('login-screen').style.display='block';
  document.getElementById('l-user').value='';document.getElementById('l-pass').value='';
  document.getElementById('login-err').style.display='none';
  document.getElementById('login-btn').textContent='Sign In →';document.getElementById('login-btn').disabled=false;
}
function setTbDate(){document.getElementById('tb-date').textContent=new Date().toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',year:'numeric'});
  // Show role badge in topbar
  const roleBadgeEl=document.getElementById('tb-role-badge');
  if(roleBadgeEl && currentUser){
    roleBadgeEl.textContent=currentUser.role;
    const colors={Administrator:'background:rgba(139,92,246,.2);color:#a78bfa;border:1px solid rgba(139,92,246,.35)',Pastor:'background:rgba(245,158,11,.15);color:#fbbf24;border:1px solid rgba(245,158,11,.3)',Secretary:'background:rgba(99,102,241,.15);color:#818cf8;border:1px solid rgba(99,102,241,.3)',Deacon:'background:rgba(99,102,241,.15);color:#818cf8;border:1px solid rgba(99,102,241,.3)'};
    roleBadgeEl.style.cssText=(colors[currentUser.role]||colors.Deacon)+';padding:2px 9px;border-radius:20px;font-size:10px;font-weight:600;font-family:DM Sans,sans-serif';
  }}

// ════════ NAVIGATION ════════
const PAGE_TITLES={dashboard:'Dashboard',members:'Member Directory',attendance:'Attendance',sms:'BulkSMS Center',birthdays:'Birthdays & Anniversaries',visitors:'Visitor Log',settings:'Settings'};
function goPage(p){
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('show'));
  document.querySelectorAll('.nav-item').forEach(x=>x.classList.remove('active'));
  const pg=document.getElementById('page-'+p);if(pg)pg.classList.add('show');
  const ni=document.getElementById('ni-'+p);if(ni)ni.classList.add('active');
  const tb=document.getElementById('tb-title');if(tb)tb.textContent=PAGE_TITLES[p]||p;
  if(p==='dashboard')renderDashboard();
  if(p==='members'){renderMemStats();renderDir();showMemView('dir');}
  if(p==='attendance'){const d=document.getElementById('att-date');if(d&&!d.value)d.value=todayStr();refreshAtt();}
  if(p==='sms'){renderSmsTemplates();renderSmsMembers();renderSmsLog();}
  if(p==='birthdays')renderBirthdays();
  if(p==='visitors')renderVisitors();
  if(p==='settings'){loadSbConfig();loadSmsConfig();}
}

// ════════ AVATAR ════════
function avHtml(m,sz){
  const c=avColor(m.id);
  if(m.photo)return`<div style="width:${sz}px;height:${sz}px;border-radius:50%;overflow:hidden;flex-shrink:0;border:2px solid ${c}44"><img src="${m.photo}" style="width:100%;height:100%;object-fit:cover"/></div>`;
  return`<div style="width:${sz}px;height:${sz}px;border-radius:50%;flex-shrink:0;background:radial-gradient(135deg at 30% 30%,${c}cc,${c}44);border:2px solid ${c}44;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-weight:700;font-size:${Math.round(sz*.36)}px;color:#fff">${initials(m)}</div>`;
}

// ════════ ACTIVITY ════════
function addAct(icon,text,color){activityLog.unshift({icon,text,color,time:new Date()});if(activityLog.length>20)activityLog.pop();}

// ════════ DASHBOARD ════════
function showEldersModal(){
  var eldersMembers = members.filter(function(m){ return ['Elder','Deacon','Deaconess'].includes(m.memberType) || ['Elder','Deacon','Deaconess'].includes(m.position); });
  var modal = document.getElementById('elders-modal');
  var sub = document.getElementById('elders-modal-sub');
  var body = document.getElementById('elders-modal-body');
  sub.textContent = eldersMembers.length + ' member' + (eldersMembers.length !== 1 ? 's' : '') + ' in Elders & Deacons';
  if(!eldersMembers.length){
    body.innerHTML = '<div style="text-align:center;padding:40px;color:#5a4e42;font-size:13px">No Elders or Deacons registered yet.</div>';
  } else {
    body.innerHTML = eldersMembers.map(function(m){
      var initStr = (m.firstName[0]+(m.lastName?m.lastName[0]:'')).toUpperCase();
      var av = m.photo ? '<img src="'+m.photo+'" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid #c47e8a" />' : '<div style="width:44px;height:44px;border-radius:50%;background:#c47e8a;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff">'+initStr+'</div>';
      return '<div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.05)">'
        + av
        + '<div style="flex:1">'
        + '<div style="font-size:14px;font-weight:700;color:#f0e8d8">'+m.firstName+' '+(m.lastName||'')+'</div>'
        + '<div style="font-size:11px;color:#5a4e42;margin-top:2px">'+(m.position||m.memberType)+' &nbsp;·&nbsp; '+(m.gender||'')+(m.ministry?' &nbsp;·&nbsp; '+m.ministry:'')+'</div>'
        + '</div>'
        + '<div style="font-size:11px;color:#c47e8a;font-weight:700">'+(m.phone||'')+'</div>'
        + '</div>';
    }).join('');
  }
  modal.style.display = 'flex';
}

function printElders(){
  var eldersMembers = members.filter(function(m){ return ['Elder','Deacon','Deaconess'].includes(m.memberType) || ['Elder','Deacon','Deaconess'].includes(m.position); });
  var printContent = buildPrintHTML('Elders & Deacons', '#c47e8a', eldersMembers);
  var iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:800px;height:600px';
  document.body.appendChild(iframe);
  iframe.contentDocument.open();
  iframe.contentDocument.write(printContent);
  iframe.contentDocument.close();
  setTimeout(function(){ iframe.contentWindow.print(); setTimeout(function(){ document.body.removeChild(iframe); }, 1000); }, 600);
}

function showMinistryModal(ministry, color){
  var minMembers = members.filter(function(m){ return m.ministry === ministry; });
  var modal = document.getElementById('ministry-modal');
  var title = document.getElementById('ministry-modal-title');
  var sub = document.getElementById('ministry-modal-sub');
  var body = document.getElementById('ministry-modal-body');
  var printBtn = document.getElementById('ministry-print-btn');
  title.textContent = ministry;
  title.style.color = color;
  sub.textContent = minMembers.length + ' member' + (minMembers.length !== 1 ? 's' : '') + ' in this ministry';
  printBtn.style.background = 'rgba('+parseInt(color.slice(1,3),16)+','+parseInt(color.slice(3,5),16)+','+parseInt(color.slice(5,7),16)+',.15)';
  printBtn.style.color = color;
  printBtn.style.borderColor = color;
  printBtn.onclick = function(){ printMinistry(ministry, color); };
  if(!minMembers.length){
    body.innerHTML = '<div style="text-align:center;padding:40px;color:#5a4e42;font-size:13px">No members registered in '+ministry+' yet.</div>';
  } else {
    body.innerHTML = minMembers.map(function(m){
      var initStr = (m.firstName[0]+(m.lastName?m.lastName[0]:'')).toUpperCase();
      var av = m.photo ? '<img src="'+m.photo+'" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid '+color+'" />' : '<div style="width:44px;height:44px;border-radius:50%;background:'+color+';display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff">'+initStr+'</div>';
      return '<div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.05)">'
        + av
        + '<div style="flex:1">'
        + '<div style="font-size:14px;font-weight:700;color:#f0e8d8">'+m.firstName+' '+(m.lastName||'')+'</div>'
        + '<div style="font-size:11px;color:#5a4e42;margin-top:2px">'+(m.position||m.memberType||'Member')+' &nbsp;·&nbsp; '+(m.gender||'')+'</div>'
        + '</div>'
        + '<div style="font-size:11px;color:'+color+';font-weight:700">'+(m.phone||'')+'</div>'
        + '</div>';
    }).join('');
  }
  modal.style.display = 'flex';
}

function showDayBornModal(day, color){
  var dayMembers = members.filter(function(m){
    if(!m.dob) return false;
    var d = new Date(m.dob);
    var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    return !isNaN(d) && days[d.getDay()] === day;
  });
  var modal = document.getElementById('dayborn-modal');
  var title = document.getElementById('dayborn-modal-title');
  var sub = document.getElementById('dayborn-modal-sub');
  var body = document.getElementById('dayborn-modal-body');
  title.textContent = day + ' Borns';
  title.style.color = color;
  sub.textContent = dayMembers.length + ' member' + (dayMembers.length !== 1 ? 's' : '') + ' born on ' + day;
  if(!dayMembers.length){
    body.innerHTML = '<div style="text-align:center;padding:40px;color:#5a4e42;font-size:13px">No members born on ' + day + ' yet.</div>';
  } else {
    body.innerHTML = dayMembers.map(function(m){
      var initStr = (m.firstName[0]+(m.lastName?m.lastName[0]:'')).toUpperCase();
      var av = m.photo ? '<img src="'+m.photo+'" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid '+color+'" />' : '<div style="width:44px;height:44px;border-radius:50%;background:'+color+';display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff">'+initStr+'</div>';
      return '<div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.05)">'
        + av
        + '<div style="flex:1">'
        + '<div style="font-family:Georgia,serif;font-size:14px;font-weight:700;color:#f0e8d8">'+m.firstName+' '+(m.lastName||'')+'</div>'
        + '<div style="font-size:11px;color:#5a4e42;margin-top:2px">'+(m.position||m.memberType||'Member')+' &nbsp;·&nbsp; DOB: '+(m.dob||'—')+'</div>'
        + '</div>'
        + '<div style="font-size:11px;color:'+color+';font-weight:700">'+(m.phone||'')+'</div>'
        + '</div>';
    }).join('');
  }
  modal.style.display = 'flex';
  // Store current day for print
  modal.setAttribute('data-day', day);
  modal.setAttribute('data-color', color);
}

function buildPrintHTML(title, color, memberList){
  var rows = memberList.map(function(m,i){
    return '<tr>'
      + '<td>'+(i+1)+'</td>'
      + '<td><strong>'+m.firstName+' '+(m.lastName||'')+'</strong></td>'
      + '<td>'+(m.gender||'—')+'</td>'
      + '<td>'+(m.dob||'—')+'</td>'
      + '<td>'+(m.dayBorn||'—')+'</td>'
      + '<td>'+(m.phone||'—')+'</td>'
      + '<td>'+(m.position||m.memberType||'Member')+'</td>'
      + '</tr>';
  }).join('');
  return '<!DOCTYPE html><html><head><title>'+title+'</title>'
    + '<style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:Arial,sans-serif;padding:24px;color:#222;font-size:13px}'
    + 'h1{color:'+color+';font-size:20px;margin-bottom:4px}h2{font-size:15px;color:#555;margin-bottom:4px}'
    + 'p{color:#888;font-size:11px;margin-bottom:16px}'
    + 'table{width:100%;border-collapse:collapse;margin-top:8px}'
    + 'th{background:'+color+';color:#fff;padding:9px 10px;text-align:left;font-size:12px}'
    + 'td{padding:8px 10px;border-bottom:1px solid #eee;font-size:12px}'
    + 'tr:nth-child(even){background:#f9f9f9}'
    + '.footer{margin-top:20px;font-size:11px;color:#aaa;text-align:center}'
    + '.print-btn{margin-top:16px;padding:10px 24px;background:'+color+';color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:13px}'
    + '@media print{.print-btn{display:none}}'
    + '</style></head><body>'
    + '<h1>CACI O6 Assembly</h1>'
    + '<h2>'+title+'</h2>'
    + '<p>Total: '+memberList.length+' member'+(memberList.length!==1?'s':'')+' &nbsp;|&nbsp; Printed: '+new Date().toLocaleDateString()+'</p>'
    + '<table><thead><tr><th>#</th><th>Name</th><th>Gender</th><th>DOB</th><th>Day Born</th><th>Phone</th><th>Role/Type</th></tr></thead><tbody>'+rows+'</tbody></table>'
    + '<div class="footer">CACI O6 Assembly Church Management System</div>'
    + '<br><button class="print-btn" onclick="window.print()">🖨 Print / Save as PDF</button>'
    + '</body></html>';
}

function printDayBorn(){
  var modal = document.getElementById('dayborn-modal');
  var day = modal.getAttribute('data-day');
  var color = modal.getAttribute('data-color');
  var dayMembers = members.filter(function(m){
    if(!m.dob) return false;
    var d = new Date(m.dob);
    var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    return !isNaN(d) && days[d.getDay()] === day;
  });
  var printContent = buildPrintHTML(day+' Borns', color, dayMembers);
  var iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:800px;height:600px';
  document.body.appendChild(iframe);
  iframe.contentDocument.open();
  iframe.contentDocument.write(printContent);
  iframe.contentDocument.close();
  setTimeout(function(){ iframe.contentWindow.print(); setTimeout(function(){ document.body.removeChild(iframe); }, 1000); }, 600);
}

function printMinistry(ministry, color){
  var minMembers = members.filter(function(m){ return m.ministry === ministry; });
  var printContent = buildPrintHTML(ministry+' Members', color, minMembers);
  var iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:800px;height:600px';
  document.body.appendChild(iframe);
  iframe.contentDocument.open();
  iframe.contentDocument.write(printContent);
  iframe.contentDocument.close();
  setTimeout(function(){ iframe.contentWindow.print(); setTimeout(function(){ document.body.removeChild(iframe); }, 1000); }, 600);
}

