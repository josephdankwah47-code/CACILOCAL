function printBirthdays(){
  var today = new Date();
  var list = members.filter(function(m){
    if(!m.dob) return false;
    var d = new Date(m.dob);
    return d.getMonth()===today.getMonth() && d.getDate()===today.getDate();
  });
  var printContent = buildPrintHTML('Birthdays Today', '#d4956a', list);
  var iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:800px;height:600px';
  document.body.appendChild(iframe);
  iframe.contentDocument.open();
  iframe.contentDocument.write(printContent);
  iframe.contentDocument.close();
  setTimeout(function(){ iframe.contentWindow.print(); setTimeout(function(){ document.body.removeChild(iframe); },1000); },600);
}
function printSmsLog(){
  var rows = smsLog.map(function(s,i){
    return '<tr><td>'+(i+1)+'</td><td>'+(s.to||'—')+'</td><td>'+(s.message||'—')+'</td><td>'+(s.date||'—')+'</td><td>'+(s.status||'—')+'</td></tr>';
  }).join('');
  var content = '<!DOCTYPE html><html><head><title>SMS Log - CACI O6 Assembly</title>'
    +'<style>body{font-family:Arial,sans-serif;padding:20px}table{width:100%;border-collapse:collapse}th{background:#6aabee;color:#fff;padding:9px;text-align:left}td{padding:8px;border-bottom:1px solid #eee}tr:nth-child(even){background:#f9f9f9}.print-btn{margin-top:16px;padding:10px 24px;background:#6aabee;color:#fff;border:none;border-radius:6px;cursor:pointer}@media print{.print-btn{display:none}}</style>'
    +'</head><body><h2 style="color:#6aabee">CACI O6 Assembly - SMS Log</h2><p>Total: '+smsLog.length+' messages | Printed: '+new Date().toLocaleDateString()+'</p>'
    +'<table><thead><tr><th>#</th><th>To</th><th>Message</th><th>Date</th><th>Status</th></tr></thead><tbody>'+rows+'</tbody></table>'
    +'<br><button class="print-btn" onclick="window.print()">🖨 Print / Save PDF</button></body></html>';
  var iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:800px;height:600px';
  document.body.appendChild(iframe);
  iframe.contentDocument.open();
  iframe.contentDocument.write(content);
  iframe.contentDocument.close();
  setTimeout(function(){ iframe.contentWindow.print(); setTimeout(function(){ document.body.removeChild(iframe); },1000); },600);
}
function printGender(){
  var male = members.filter(function(m){ return m.gender==='Male'; });
  var female = members.filter(function(m){ return m.gender==='Female'; });
  var content = '<!DOCTYPE html><html><head><title>Gender Report - CACI O6 Assembly</title>'
    +'<style>body{font-family:Arial,sans-serif;padding:20px}h1{color:#333}h2{color:#555;margin-top:20px}.count{font-size:36px;font-weight:900;margin:10px 0}table{width:100%;border-collapse:collapse;margin-top:10px}th{background:#555;color:#fff;padding:9px;text-align:left}td{padding:8px;border-bottom:1px solid #eee}tr:nth-child(even){background:#f9f9f9}.print-btn{margin-top:16px;padding:10px 24px;background:#555;color:#fff;border:none;border-radius:6px;cursor:pointer}@media print{.print-btn{display:none}}</style>'
    +'</head><body><h1>CACI O6 Assembly - Gender Report</h1><p>Printed: '+new Date().toLocaleDateString()+'</p>'
    +'<div style="display:flex;gap:40px;margin:20px 0">'
    +'<div style="text-align:center"><div class="count" style="color:#8fa8d4">'+male.length+'</div><div>Male Members</div></div>'
    +'<div style="text-align:center"><div class="count" style="color:#c47e8a">'+female.length+'</div><div>Female Members</div></div>'
    +'<div style="text-align:center"><div class="count" style="color:#f0e8d8">'+members.length+'</div><div>Total Members</div></div>'
    +'</div>'
    +'<h2 style="color:#8fa8d4">Male Members ('+male.length+')</h2>'
    +'<table><thead><tr><th>#</th><th>Name</th><th>Phone</th><th>Position</th></tr></thead><tbody>'
    +male.map(function(m,i){ return '<tr><td>'+(i+1)+'</td><td>'+m.firstName+' '+(m.lastName||'')+'</td><td>'+(m.phone||'—')+'</td><td>'+(m.position||m.memberType||'Member')+'</td></tr>'; }).join('')
    +'</tbody></table>'
    +'<h2 style="color:#c47e8a">Female Members ('+female.length+')</h2>'
    +'<table><thead><tr><th>#</th><th>Name</th><th>Phone</th><th>Position</th></tr></thead><tbody>'
    +female.map(function(m,i){ return '<tr><td>'+(i+1)+'</td><td>'+m.firstName+' '+(m.lastName||'')+'</td><td>'+(m.phone||'—')+'</td><td>'+(m.position||m.memberType||'Member')+'</td></tr>'; }).join('')
    +'</tbody></table>'
    +'<br><button class="print-btn" onclick="window.print()">🖨 Print / Save PDF</button></body></html>';
  var iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:800px;height:600px';
  document.body.appendChild(iframe);
  iframe.contentDocument.open();
  iframe.contentDocument.write(content);
  iframe.contentDocument.close();
  setTimeout(function(){ iframe.contentWindow.print(); setTimeout(function(){ document.body.removeChild(iframe); },1000); },600);
}
function printAllDayBorns(){
  var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  var clrs = {Sunday:'#d4956a',Monday:'#8fa8d4',Tuesday:'#7eaa92',Wednesday:'#c47e8a',Thursday:'#6aabee',Friday:'#f0c060',Saturday:'#9b8fd4'};
  var sections = days.map(function(day){
    var list = members.filter(function(m){ if(!m.dob) return false; var d=new Date(m.dob); return !isNaN(d)&&days[d.getDay()]===day; });
    var rows = list.map(function(m,i){ return '<tr><td>'+(i+1)+'</td><td>'+m.firstName+' '+(m.lastName||'')+'</td><td>'+(m.phone||'—')+'</td><td>'+(m.dob||'—')+'</td></tr>'; }).join('');
    return '<h2 style="color:'+clrs[day]+';margin-top:20px">'+day+' ('+list.length+')</h2>'+(list.length?'<table><thead><tr><th>#</th><th>Name</th><th>Phone</th><th>DOB</th></tr></thead><tbody>'+rows+'</tbody></table>':'<p style="color:#aaa">No members</p>');
  }).join('');
  var content = '<!DOCTYPE html><html><head><title>Day Borns - CACI O6 Assembly</title>'
    +'<style>body{font-family:Arial,sans-serif;padding:20px}table{width:100%;border-collapse:collapse;margin-top:8px}th{padding:9px;text-align:left;color:#fff}td{padding:8px;border-bottom:1px solid #eee}tr:nth-child(even){background:#f9f9f9}.print-btn{margin-top:16px;padding:10px 24px;background:#333;color:#fff;border:none;border-radius:6px;cursor:pointer}@media print{.print-btn{display:none}}</style>'
    +'</head><body><h1>CACI O6 Assembly - Day Borns Report</h1><p>Total Members: '+members.length+' | Printed: '+new Date().toLocaleDateString()+'</p>'
    +sections
    +'<br><button class="print-btn" onclick="window.print()">🖨 Print / Save PDF</button></body></html>';
  var iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:800px;height:600px';
  document.body.appendChild(iframe);
  iframe.contentDocument.open();
  iframe.contentDocument.write(content);
  iframe.contentDocument.close();
  setTimeout(function(){ iframe.contentWindow.print(); setTimeout(function(){ document.body.removeChild(iframe); },1000); },600);
}
function updateDayBorn(){
  var dob = document.getElementById('f-dob').value;
  var el = document.getElementById('f-dayborn');
  if(!el) return;
  if(!dob){ el.value=''; return; }
  var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  var d = new Date(dob);
  el.value = isNaN(d) ? '' : days[d.getDay()];
}
function renderDashboard(){
  const banner = document.getElementById('dash-reconnect-banner');
  if(banner) banner.style.display = supabaseConnected ? 'none' : 'flex';
  const now=new Date(),h=now.getHours();
  const greet=h<12?'Good morning':h<17?'Good afternoon':'Good evening';
  const gEl=document.getElementById('dash-greet');if(gEl)gEl.textContent=`${greet}, ${currentUser?currentUser.name.split(' ')[0]:''}`;
  const dsEl=document.getElementById('dash-date-sub');if(dsEl)dsEl.textContent=now.toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  const active=members.filter(m=>m.status==='Active').length;
  const visNew=visitors.filter(v=>v.status==='New').length;
  const todayBdays=members.filter(m=>m.dob&&daysUntil(m.dob.slice(5))===0).length;
  const stEl=document.getElementById('dash-stats');
  if(stEl)stEl.innerHTML=[
    {icon:'👥',label:'Total Members',val:members.length,color:'#f0e8d8',fn:"goPage(\'members\')",pfn:"printAllMembers()"},
    {icon:'✅',label:'Active Members',val:active,color:'#7eaa92',fn:"goPage(\'members\')",pfn:"printActiveMembers()"},
    {icon:'🙋',label:'New Visitors',val:visNew,color:'#8fa8d4',fn:"goPage(\'visitors\')",pfn:"printVisitors()"},
    {icon:'🎂',label:'Birthdays Today',val:todayBdays,color:'#d4956a',fn:"goPage(\'birthdays\')",pfn:"printBirthdays()"},
    {icon:'📱',label:'SMS Sent',val:smsLog.length,color:'#6aabee',fn:"goPage(\'sms\')",pfn:"printSmsLog()"},
    {icon:'⛪',label:'Elders & Deacons',val:members.filter(m=>['Elder','Deacon'].includes(m.memberType)).length,color:'#c47e8a',fn:"showEldersModal()",pfn:"printElders()"},
  ].map(s=>`<div class="stat-card" ${s.fn?'onclick="'+s.fn+'" style="cursor:pointer"':''} ><div class="stat-icon">${s.icon}</div><div class="stat-num" style="color:${s.color}">${s.val}</div><div class="stat-lbl">${s.label}</div>${s.pfn?'<button onclick="event.stopPropagation();'+s.pfn+'" style="margin-top:6px;background:rgba(255,255,255,.06);color:#8fa8d4;border:1px solid rgba(255,255,255,.1);padding:3px 8px;border-radius:5px;font-size:9px;cursor:pointer;width:100%">🖨 Print</button>':''}</div>`).join('');
  const qaEl=document.getElementById('quick-actions');
  if(qaEl)qaEl.innerHTML=[
    {icon:'➕',label:'Register Member',fn:"goPage('members');setTimeout(()=>openRegForm(),120)"},
    {icon:'✅',label:'Take Attendance',fn:"goPage('attendance')"},
    {icon:'📱',label:'Send SMS',fn:"goPage('sms')"},
    {icon:'🙋',label:'Log Visitor',fn:"goPage('visitors');setTimeout(()=>openVisitorForm(),120)"},
  ].map(a=>`<div class="qa-card" onclick="${a.fn}"><div class="qa-icon">${a.icon}</div><div class="qa-label">${a.label}</div></div>`).join('');
  const feedEl=document.getElementById('activity-feed');
  if(feedEl){
    if(!activityLog.length)feedEl.innerHTML='<div style="text-align:center;color:#4a3e42;font-size:12px;padding:18px">No recent activity yet.</div>';
    else feedEl.innerHTML=activityLog.slice(0,10).map(a=>`<div class="activity-item"><div class="act-dot" style="background:${a.color}"></div><div style="flex:1"><div style="font-size:12px;color:#c0a888">${a.text}</div><div style="font-size:10px;color:#4a3e42;margin-top:1px">${a.time.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}</div></div></div>`).join('');
  }
  const chartEl=document.getElementById('att-chart'),labEl=document.getElementById('att-chart-labels');
  if(chartEl){
    const keys=Object.keys(attData).slice(-6);
    if(!keys.length){chartEl.innerHTML='<div style="color:#4a3e42;font-size:11px;margin:auto;text-align:center">No attendance data yet</div>';if(labEl)labEl.innerHTML='';}
    else{
      const maxP=Math.max(...keys.map(k=>Object.values(attData[k]||{}).filter(v=>v==='present').length),1);
      chartEl.innerHTML=keys.map(k=>{const cnt=Object.values(attData[k]||{}).filter(v=>v==='present').length;const pct=Math.round((cnt/maxP)*100);return`<div style="display:flex;flex-direction:column;align-items:center;flex:1;gap:3px"><div class="chart-bar" style="width:100%;height:${Math.max(pct,6)}%;background:linear-gradient(180deg,#0078ff,#00aaff)" data-tip="${cnt} present · ${fmtShort(k.split('__')[0])}"></div><div class="chart-lbl">${cnt}</div></div>`;}).join('');
      if(labEl)labEl.innerHTML=keys.map(k=>`<div style="flex:1;font-size:7px;color:#3a3028;text-align:center">${k.split('__')[0].slice(5)}</div>`).join('');
    }
  }
  const bdayEl=document.getElementById('dash-bdays');
  if(bdayEl){
    const wb=members.filter(m=>m.dob&&daysUntil(m.dob.slice(5))<=7).sort((a,b)=>daysUntil(a.dob.slice(5))-daysUntil(b.dob.slice(5)));
    bdayEl.innerHTML=wb.length?wb.map(m=>`<div style="display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.05)">${avHtml(m,32)}<div style="flex:1"><div style="font-family:'Playfair Display',serif;font-size:12px;font-weight:700;color:#f0e8d8">${m.firstName} ${m.lastName}</div><div style="font-size:10px;color:#5a4e42">${fmtShort(m.dob)}</div></div>${dayPill(daysUntil(m.dob.slice(5)))}</div>`).join(''):'<div style="color:#4a3e42;font-size:12px;padding:6px">No birthdays this week.</div>';
  }
  const fuEl=document.getElementById('followup-list'),fcEl=document.getElementById('followup-count');
  if(fuEl){
    const pending=visitors.filter(v=>v.status==='New');
    if(fcEl)fcEl.textContent=pending.length;
    if(!pending.length)fuEl.innerHTML='<div style="text-align:center;color:#4a3e42;font-size:12px;padding:16px">No pending follow-ups.</div>';
    else fuEl.innerHTML=pending.slice(0,5).map(v=>`<div class="fu-item"><div style="width:6px;height:6px;border-radius:50%;background:#7eaa92;flex-shrink:0"></div><div style="flex:1"><div style="font-family:'Playfair Display',serif;font-size:12px;color:#f0e8d8">${v.firstName} ${v.lastName}</div><div style="font-size:10px;color:#5a4e42">${fmtShort(v.date)}</div></div><button onclick="updateVisitorStatus(${v.id},'Contacted')" style="background:rgba(212,149,106,.1);color:#d4956a;border:1px solid rgba(212,149,106,.2);padding:3px 9px;border-radius:5px;font-family:'DM Sans',sans-serif;font-size:10px;cursor:pointer">Contacted</button></div>`).join('');
  }
  // ── Gender Widget ──
  var gWid=document.getElementById('gender-widget');
  if(gWid){
    var male=members.filter(function(m){return m.gender==='Male';}).length;
    var female=members.filter(function(m){return m.gender==='Female';}).length;
    var other=members.filter(function(m){return m.gender&&m.gender!=='Male'&&m.gender!=='Female';}).length;
    var tot=members.length||1;
    if(!members.length){gWid.innerHTML='<div style="color:#4a3e42;font-size:12px;padding:6px">No members yet.</div>';}
    else{
      var mp=Math.round((male/tot)*100);
      var fp=Math.round((female/tot)*100);
      gWid.style.cursor='pointer';gWid.onclick=function(){goPage('members');};gWid.innerHTML='<div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;margin-bottom:4px"><span style="font-size:12px;color:#8fa8d4">Male</span><span style="font-size:12px;color:#8fa8d4;font-weight:700">'+male+'</span></div><div style="background:rgba(255,255,255,.07);border-radius:20px;height:8px;overflow:hidden"><div style="width:'+mp+'%;height:100%;background:linear-gradient(90deg,#0078ff,#00c8ff);border-radius:20px"></div></div></div><div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;margin-bottom:4px"><span style="font-size:12px;color:#c47e8a">Female</span><span style="font-size:12px;color:#c47e8a;font-weight:700">'+female+'</span></div><div style="background:rgba(255,255,255,.07);border-radius:20px;height:8px;overflow:hidden"><div style="width:'+fp+'%;height:100%;background:linear-gradient(90deg,#c47e8a,#e0a0b0);border-radius:20px"></div></div></div><div style="display:flex;justify-content:space-around;margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,.06)"><div style="text-align:center"><div style="font-size:18px;font-weight:700;color:#8fa8d4">'+mp+'%</div><div style="font-size:10px;color:#4a3e42">Male</div></div><div style="text-align:center"><div style="font-size:18px;font-weight:700;color:#c47e8a">'+fp+'%</div><div style="font-size:10px;color:#4a3e42">Female</div></div></div>';
    }
  }
  // ── Day Borns Widget ──
  // Day Borns widget (bar chart)
  var dbWid=document.getElementById('dayborn-widget');
  var dayKeys=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  var dayIds=['sun','mon','tue','wed','thu','fri','sat'];
  var dc={Sunday:0,Monday:0,Tuesday:0,Wednesday:0,Thursday:0,Friday:0,Saturday:0};
  members.forEach(function(m){if(m.dob){var d=new Date(m.dob);if(!isNaN(d))dc[dayKeys[d.getDay()]]++;}});
  var maxD=Math.max.apply(null,Object.values(dc).concat([1]));
  var clrs={Sunday:'#d4956a',Monday:'#8fa8d4',Tuesday:'#7eaa92',Wednesday:'#c47e8a',Thursday:'#6aabee',Friday:'#f0c060',Saturday:'#9b8fd4'};
  if(dbWid){
    dbWid.style.cursor='pointer';dbWid.onclick=function(){goPage('members');};
    if(!members.length){dbWid.innerHTML='<div style="color:#4a3e42;font-size:12px;padding:6px">No members yet.</div>';}
    else{dbWid.innerHTML=dayKeys.map(function(day){return '<div style="display:flex;align-items:center;gap:8px;margin-bottom:7px"><div style="font-size:10px;color:#5a4e42;width:30px">'+day.slice(0,3)+'</div><div style="flex:1;background:rgba(255,255,255,.07);border-radius:20px;height:7px;overflow:hidden"><div style="width:'+Math.round((dc[day]/maxD)*100)+'%;height:100%;background:'+clrs[day]+';border-radius:20px"></div></div><div style="font-size:11px;font-weight:700;color:'+clrs[day]+';width:20px;text-align:right">'+dc[day]+'</div></div>';}).join('');}
  }
  // Update individual day cards
  dayKeys.forEach(function(day,i){
    var el=document.getElementById('day-'+dayIds[i]);
    if(el) el.textContent=dc[day];
  });
  // Update ministry counts
  var minMap = {'Youth':'min-youth','Young Ladies':'min-youngladies','Men Fellowship':'min-men','Good Women Fellowship':'min-goodwomen'};
  Object.keys(minMap).forEach(function(min){
    var el = document.getElementById(minMap[min]);
    if(el) el.textContent = members.filter(function(m){ return m.ministry === min; }).length;
  });
  const nb=document.getElementById('bday-nav-badge');
  if(nb){const n=members.filter(m=>m.dob&&daysUntil(m.dob.slice(5))<=7).length;nb.textContent=n;nb.style.display=n>0?'inline':'none';}
}

// ════════ MEMBERS ════════
function renderMemStats(){
  const el=document.getElementById('mem-stats');if(!el)return;
  el.innerHTML=[{l:'Total',v:members.length,c:'#f0e8d8'},{l:'Active',v:members.filter(m=>m.status==='Active').length,c:'#7eaa92'},{l:'Elders & Deacons',v:members.filter(m=>['Elder','Deacon'].includes(m.memberType)).length,c:'#d4956a'},{l:'Youth',v:members.filter(m=>m.memberType==='Youth Member').length,c:'#8fa8d4'}].map(s=>`<div class="stat-card"><div class="stat-num" style="color:${s.c}">${s.v}</div><div class="stat-lbl">${s.l}</div></div>`).join('');
}
function renderDir(){
  const q=(document.getElementById('mem-search').value||'').toLowerCase();
  const ft=(document.getElementById('mem-ftype')||{}).value||'';
  const fs=(document.getElementById('mem-fstatus')||{}).value||'';
  const filtered=members.filter(m=>`${m.firstName} ${m.lastName} ${m.phone} ${m.family}`.toLowerCase().includes(q)&&(!ft||m.memberType===ft)&&(!fs||m.status===fs));
  const grid=document.getElementById('member-grid');if(!grid)return;
  if(!members.length){grid.innerHTML=`<div class="empty-state" style="grid-column:1/-1"><div class="empty-icon">👥</div><h3 style="font-size:18px;margin-bottom:7px;color:#6a5e52">No members yet</h3><p style="font-size:12px;margin-bottom:16px">Register your first congregant to get started</p>${canEdit()?'<button class="btn-gold" onclick="openRegForm()">+ Register First Member</button>':'<span style="font-size:12px;color:#7c6fcd">Contact your Administrator to register members</span>'}</div>`;return;}
  if(!filtered.length){grid.innerHTML=`<div class="empty-state" style="grid-column:1/-1"><h3 style="font-size:17px;color:#6a5e52">No members found</h3><p style="font-size:12px">Adjust your search or filters</p></div>`;return;}
  grid.innerHTML=filtered.map(m=>`<div class="member-card" onclick="openMemModal(${m.id})">${avHtml(m,40)}<div style="flex:1;min-width:0"><div style="font-family:'Playfair Display',serif;font-size:13px;font-weight:700;color:#f0e8d8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${m.firstName} ${m.lastName}</div><div style="font-size:10px;color:#6a5e52;margin-top:2px">${m.memberType}${m.position?' · '+m.position:''}${m.family?' · '+m.family:''}</div><div style="font-size:10px;color:#4a3e42;margin-top:1px">${m.phone}</div></div><span class="badge ${bCls(m.status)}">${m.status}</span></div>`).join('');
}
function showMemView(v){
  document.getElementById('mem-dir').style.display=v==='dir'?'block':'none';
  document.getElementById('mem-form').style.display=v==='form'?'block':'none';
  const btn=document.getElementById('mem-hdr-btn');if(!btn)return;
  if(v==='dir'){
    btn.innerHTML=canEdit()?`<button class="btn-gold" onclick="openRegForm()">+ Register Member</button>`:`<span style="font-size:11px;color:#7c6fcd;background:rgba(139,92,246,.08);border:1px solid rgba(139,92,246,.2);padding:8px 14px;border-radius:8px;display:inline-block">🔒 View-only access — contact Admin to add members</span>`;
    renderMemStats();renderDir();
  }
  else btn.innerHTML=`<button class="btn-dark" onclick="showMemView('dir')">← Back</button>`;
}
function setGender(val){
  document.getElementById('f-gender').value = val;
  ['Male','Female','Other'].forEach(g => {
    const btn = document.getElementById('g-'+g.toLowerCase());
    if(!btn) return;
    if(g === val){
      btn.style.background = 'linear-gradient(135deg,rgba(0,120,255,.3),rgba(0,200,255,.15))';
      btn.style.borderColor = '#0096ff';
      btn.style.color = '#00d4ff';
      btn.style.boxShadow = '0 0 0 2px rgba(0,160,255,.2)';
    } else {
      btn.style.background = 'rgba(255,255,255,.04)';
      btn.style.borderColor = 'rgba(0,100,200,.2)';
      btn.style.color = '#3a7090';
      btn.style.boxShadow = 'none';
    }
  });
  // clear error
  const err = document.getElementById('e-gender');
  if(err) err.textContent = '';
}

function openGoogleMaps(){
  window.open('https://maps.google.com','_blank');
}

function updateLocationPreview(){
  const val = (document.getElementById('f-location')||{}).value||'';
  const prev = document.getElementById('f-location-preview');
  if(!prev) return;
  if(val && (val.includes('google.com/maps') || val.includes('maps.app.goo') || val.includes('goo.gl/maps'))){
    prev.style.display = 'flex';
    prev.innerHTML = '📍 <span>Location link saved — <a href="'+val+'" target="_blank" style="color:#34d399;text-decoration:underline">Click to preview on Google Maps</a></span>';
  } else if(val) {
    prev.style.display = 'flex';
    prev.style.background = 'rgba(245,158,11,.08)';
    prev.style.borderColor = 'rgba(245,158,11,.2)';
    prev.style.color = '#fbbf24';
    prev.innerHTML = '⚠ Paste a full Google Maps link (e.g. https://maps.app.goo.gl/...)';
  } else {
    prev.style.display = 'none';
  }
}

function openRegForm(member){
  editingId=member?member.id:null;formPhoto=member?member.photo||'':'';
  const gi=id=>document.getElementById(id);
  gi('f-first').value=member?member.firstName:'';gi('f-last').value=member?member.lastName:'';
  // Set gender buttons
  const gVal = member ? member.gender : '';
  gi('f-gender').value = gVal;
  ['Male','Female','Other'].forEach(g => {
    const btn = document.getElementById('g-'+g.toLowerCase());
    if(!btn) return;
    if(g === gVal){
      btn.style.background = 'linear-gradient(135deg,rgba(139,92,246,.3),rgba(99,102,241,.2))';
      btn.style.borderColor = '#8b5cf6';
      btn.style.color = '#c4b5fd';
      btn.style.boxShadow = '0 0 0 2px rgba(139,92,246,.2)';
    } else {
      btn.style.background = 'rgba(255,255,255,.04)';
      btn.style.borderColor = 'rgba(139,92,246,.2)';
      btn.style.color = '#8878c0';
      btn.style.boxShadow = 'none';
    }
  });gi('f-dob').value=member?member.dob:'';if(document.getElementById('f-dayborn')){document.getElementById('f-dayborn').value=member&&member.dayBorn?member.dayBorn:'';updateDayBorn();}
  gi('f-phone').value=member?member.phone:'';gi('f-address').value=member?member.address:'';
  gi('f-type').value=member?member.memberType:'Full Member';gi('f-status').value=member?member.status:'Active';if(gi('f-ministry'))gi('f-ministry').value=member&&member.ministry?member.ministry:'';
  gi('f-family').value=member?member.family:'';gi('f-joindate').value=member?member.joinDate:todayStr();
  gi('f-notes').value=member?member.notes:'';
  ['e-first','e-last','e-gender','e-phone'].forEach(id=>gi(id).textContent='');
  ['f-first','f-last','f-phone','f-gender'].forEach(id=>gi(id).classList.remove('err'));
  if(formPhoto){gi('photo-preview').src=formPhoto;gi('photo-preview').style.display='block';gi('photo-placeholder').style.display='none';gi('photo-ring').classList.add('has-photo');gi('photo-remove-btn').style.display='block';gi('photo-upload-btn').textContent='Change Photo';}
  else clearPhoto();
  gi('form-title').textContent=member?'Edit Member Profile':'Register New Member';
  gi('form-sub').textContent=member?'Update the member\'s information':'Complete the form to add a new congregant';
  gi('form-submit-btn').textContent=member?'Save Changes':'Register Member';
  showMemView('form');
}
function handlePhoto(input){const file=input.files[0];if(!file)return;const r=new FileReader();r.onload=ev=>{formPhoto=ev.target.result;const pv=document.getElementById('photo-preview');pv.src=formPhoto;pv.style.display='block';document.getElementById('photo-placeholder').style.display='none';document.getElementById('photo-ring').classList.add('has-photo');document.getElementById('photo-remove-btn').style.display='block';document.getElementById('photo-upload-btn').textContent='Change Photo';};r.readAsDataURL(file);input.value='';}
function clearPhoto(){formPhoto='';const gi=id=>document.getElementById(id);gi('photo-preview').style.display='none';gi('photo-placeholder').style.display='block';gi('photo-ring').classList.remove('has-photo');gi('photo-remove-btn').style.display='none';gi('photo-upload-btn').textContent='Upload Photo';}
function submitMember(){
  if(!canEdit()){showToast('Permission denied. You do not have access to register or edit members.','red');return;}
  const gi=id=>document.getElementById(id);
  ['e-first','e-last','e-gender','e-phone'].forEach(id=>gi(id).textContent='');
  ['f-first','f-last','f-phone','f-gender'].forEach(id=>gi(id).classList.remove('err'));
  const first=gi('f-first').value.trim(),last=gi('f-last').value.trim(),phone=gi('f-phone').value.trim(),gender=gi('f-gender').value;
  let ok=true;
  if(!first){gi('e-first').textContent='Required';gi('f-first').classList.add('err');ok=false;}
  if(!last){gi('e-last').textContent='Required';gi('f-last').classList.add('err');ok=false;}
  if(!phone){gi('e-phone').textContent='Required';gi('f-phone').classList.add('err');ok=false;}
  if(!gender){gi('e-gender').textContent='Required';gi('f-gender').classList.add('err');ok=false;}
  if(!ok)return;
  const days_=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];const dobVal=gi('f-dob').value;const dobDay=dobVal?days_[new Date(dobVal).getDay()]||'':'';const data={firstName:first,lastName:last,gender,dob:dobVal,dayBorn:dobDay,phone,address:gi('f-address').value.trim(),position:(gi('f-position')||{}).value||'',location:(gi('f-location')||{}).value.trim(),memberType:gi('f-type').value,ministry:(gi('f-ministry')||{}).value||'',status:gi('f-status').value,family:gi('f-family').value.trim(),joinDate:gi('f-joindate').value,notes:gi('f-notes').value.trim(),photo:formPhoto};
  if(editingId!==null){members=members.map(m=>m.id===editingId?{...data,id:editingId}:m);addAct('#7eaa92',`Updated: ${first} ${last}`,'#7eaa92');const updM=members.find(m=>m.id===editingId);if(updM)sbUpsertMember(updM);showToast(`${first} ${last}'s profile updated.`);}
  else{data.id=genId();members=[data,...members];addAct('#d4956a',`New member: ${first} ${last}`,'#d4956a');sbUpsertMember(data);showToast(`${first} ${last} registered!`);}
  editingId=null;formPhoto='';saveData();showMemView('dir');renderDashboard();
}
function openMemModal(id){
  modalMemberId=id;confirmDel=false;
  const m=members.find(x=>x.id===id);if(!m)return;
  const c=avColor(m.id),av=document.getElementById('modal-avatar');
  av.style.background=m.photo?'transparent':`radial-gradient(135deg at 30% 30%,${c}cc,${c}44)`;av.style.border=`2px solid ${c}44`;
  if(m.photo)av.innerHTML=`<img src="${m.photo}" style="width:100%;height:100%;object-fit:cover"/>`;else{av.textContent=initials(m);av.style.fontSize='18px';}
  document.getElementById('modal-name').textContent=`${m.firstName} ${m.lastName}`;
  document.getElementById('modal-type').textContent=m.memberType;
  document.getElementById('modal-details').innerHTML=[['Phone',m.phone],['Gender',m.gender||'—'],['Date of Birth',fmtDate(m.dob)],['Day Born',m.dayBorn||'—'],['Position',m.position||'—'],['Family',m.family||'—'],['Join Date',fmtDate(m.joinDate)],['Address',m.address||'—'],['Ministry',m.ministry||'—'],['Member Type',m.memberType],['Status',`<span class="badge ${bCls(m.status)}">${m.status}</span>`],['Location',m.location?`<a href="${m.location}" target="_blank" style="color:#34d399;text-decoration:none;font-size:11px">📍 View on Google Maps</a>`:'—']].map(([k,v])=>`<div><div class="detail-key">${k}</div><div class="detail-val">${v}</div></div>`).join('');
  document.getElementById('modal-notes').innerHTML=m.notes?`<div class="modal-notes">${m.notes}</div>`:'';
  renderModalActions();document.getElementById('mem-modal').classList.add('open');
}
function renderModalActions(){
  const el=document.getElementById('modal-actions');
  if(confirmDel){
    el.innerHTML=`<span style="font-size:12px;color:#5a4e42;align-self:center">Remove member?</span><button class="btn-dark" style="padding:7px 12px" onclick="confirmDel=false;renderModalActions()">Cancel</button><button class="btn-red" onclick="deleteMember(${modalMemberId})">Yes, Remove</button>`;
  } else {
    const smsBtn=`<button class="btn-sms" onclick="smsSingleMember(${modalMemberId})" style="padding:7px 12px;font-size:10px">📱 SMS</button>`;
    const editBtn=canEdit()?`<button class="btn-gold" style="padding:7px 14px" onclick="editFromModal()">✎ Edit</button>`:`<span style="font-size:11px;color:#5a4e42;align-self:center;padding:4px 8px;background:rgba(255,255,255,.04);border-radius:6px;border:1px solid rgba(255,255,255,.08)">🔒 View Only</span>`;
    const delBtn=canDelete()?`<button class="btn-red" onclick="confirmDel=true;renderModalActions()">🗑 Remove</button>`:'';
    el.innerHTML=smsBtn+delBtn+editBtn;
  }
}
function editFromModal(){const m=members.find(x=>x.id===modalMemberId);closeMemModal();openRegForm(m);}
function deleteMember(id){if(!canDelete()){showToast('Permission denied. Only Administrators can delete members.','red');return;}members=members.filter(m=>m.id!==id);closeMemModal();addAct('#e07070','Member removed','#e07070');sbDeleteMember(id);saveData();showToast('Member removed.');renderMemStats();renderDir();}
function closeMemModal(){document.getElementById('mem-modal').classList.remove('open');modalMemberId=null;confirmDel=false;}

// ════════ ATTENDANCE ════════
function refreshAtt(){renderAttList();renderAttStats();}
function attMarkAll(status){members.forEach(m=>setAtt(m.id,status));const k=attKey();sbUpsertAttendance(k,attData[k]||{});saveData();refreshAtt();}
function attToggle(id,status){setAtt(id,getAtt(id)===status?null:status);const k=attKey();sbUpsertAttendance(k,attData[k]||{});saveData();refreshAtt();}
function renderAttList(){
  const q=(document.getElementById('att-search').value||'').toLowerCase();
  const filtered=members.filter(m=>`${m.firstName} ${m.lastName}`.toLowerCase().includes(q));
  const el=document.getElementById('att-list');if(!el)return;
  if(!filtered.length){el.innerHTML=`<div class="empty-state"><p>${members.length?'No match.':'Register members first.'}</p></div>`;return;}
  el.innerHTML=filtered.map(m=>{const st=getAtt(m.id);return`<div class="att-row"><div style="display:flex;align-items:center;gap:10px">${avHtml(m,34)}<div><div style="font-family:'Playfair Display',serif;font-size:13px;font-weight:700;color:#f0e8d8">${m.firstName} ${m.lastName}</div><div style="font-size:10px;color:#5a4e42">${m.memberType}${m.family?' · '+m.family:''}</div></div></div><div style="display:flex;gap:5px"><button class="mark-btn mark-present ${st==='present'?'on':''}" onclick="attToggle(${m.id},'present')">✓ Present</button><button class="mark-btn mark-absent ${st==='absent'?'on':''}" onclick="attToggle(${m.id},'absent')">✗ Absent</button></div></div>`;}).join('');
  renderAttStats();
}
function renderAttStats(){
  const present=members.filter(m=>getAtt(m.id)==='present').length;
  const absent=members.filter(m=>getAtt(m.id)==='absent').length;
  const unmarked=members.filter(m=>getAtt(m.id)===null).length;
  const rate=members.length?Math.round((present/members.length)*100):0;
  const lv=document.getElementById('att-live');if(lv)lv.innerHTML=`<span style="color:#7eaa92">${present} present</span> · <span style="color:#e07070">${absent} absent</span> · ${unmarked} unmarked`;
  const el=document.getElementById('att-stats');if(el)el.innerHTML=[{l:'Present',v:present,c:'#7eaa92'},{l:'Absent',v:absent,c:'#e07070'},{l:'Unmarked',v:unmarked,c:'#4a3e42'},{l:'Rate',v:rate+'%',c:'#d4956a'}].map(s=>`<div class="stat-card"><div class="stat-num" style="color:${s.c}">${s.v}</div><div class="stat-lbl">${s.l}</div></div>`).join('');
}
function showAttTab(tab){
  document.getElementById('att-mark-view').style.display=tab==='mark'?'block':'none';
  document.getElementById('att-report-view').style.display=tab==='report'?'block':'none';
  document.getElementById('tab-mark').classList.toggle('active',tab==='mark');
  document.getElementById('tab-report').classList.toggle('active',tab==='report');
  if(tab==='report')renderReport();
}
function renderReport(){
  const service=(document.getElementById('att-service')||{}).value||'',date=(document.getElementById('att-date')||{}).value||'';
  const rs=document.getElementById('report-sub');if(rs)rs.textContent=`${service} · ${fmtShort(date)}`;
  const present=members.filter(m=>getAtt(m.id)==='present'),absent=members.filter(m=>getAtt(m.id)==='absent');
  const rate=members.length?Math.round((present.length/members.length)*100):0;
  const rstatEl=document.getElementById('report-stats');if(rstatEl)rstatEl.innerHTML=[{l:'Total',v:members.length,c:'#f0e8d8'},{l:'Present',v:present.length,c:'#7eaa92'},{l:'Absent',v:absent.length,c:'#e07070'},{l:'Rate',v:rate+'%',c:'#d4956a'}].map(s=>`<div class="stat-card"><div class="stat-num" style="color:${s.c}">${s.v}</div><div class="stat-lbl">${s.l}</div></div>`).join('');
  const abEl=document.getElementById('absent-badge');if(abEl)abEl.textContent=absent.length;
  const pbEl=document.getElementById('present-badge');if(pbEl)pbEl.textContent=present.length;
  const atEl=document.getElementById('absent-table');if(atEl)atEl.innerHTML=buildAttTable(absent,true);
  const ptEl=document.getElementById('present-table');if(ptEl)ptEl.innerHTML=buildAttTable(present,false);
}
function buildAttTable(list,isAbsent){
  if(!list.length)return`<div style="padding:18px;text-align:center;color:#4a3e42;font-size:12px">None recorded</div>`;
  return`<table class="att-table"><thead><tr><th>#</th><th>Name</th><th>Family</th><th>Phone</th><th>Status</th></tr></thead><tbody>${list.map((m,i)=>`<tr><td>${i+1}</td><td class="nc">${m.firstName} ${m.lastName}</td><td>${m.family||'—'}</td><td>${m.phone}</td><td><span class="badge ${isAbsent?'badge-red':'badge-green'}">${isAbsent?'Absent':'Present'}</span></td></tr>`).join('')}</tbody></table>`;
}
function printReport(){
  var service=(document.getElementById('att-service')||{}).value||'';
  var date=(document.getElementById('att-date')||{}).value||'';
  var present=members.filter(function(m){return getAtt(m.id)==='present';});
  var absent=members.filter(function(m){return getAtt(m.id)==='absent';});
  var rate=members.length?Math.round((present.length/members.length)*100):0;

  if(!absent.length && !present.length){
    showToast('No attendance marked yet. Mark members first.','red');
    return;
  }

  // Build report HTML
  var absentRows = absent.length
    ? absent.map(function(m,i){
        return '<tr style="border-bottom:1px solid #eee">'
          +'<td style="padding:9px 14px;font-size:13px;color:#666">'+(i+1)+'</td>'
          +'<td style="padding:9px 14px;font-size:14px;font-weight:700;color:#111">'+m.firstName+' '+m.lastName+'</td>'
          +'<td style="padding:9px 14px;font-size:13px;color:#555">'+(m.family||'—')+'</td>'
          +'<td style="padding:9px 14px;font-size:13px;color:#555">'+m.phone+'</td>'
          +'<td style="padding:9px 14px"><span style="display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:#fdecea;color:#c62828;border:1px solid #f5c6c2">Absent</span></td>'
          +'</tr>';
      }).join('')
    : '<tr><td colspan="5" style="padding:20px;text-align:center;color:#aaa;font-size:13px">No absent members recorded.</td></tr>';

  var reportContent =
    // Header
    '<div style="text-align:center;border-bottom:3px solid #0078ff;padding-bottom:18px;margin-bottom:22px">'
    +'<div style="font-size:28px;font-weight:900;letter-spacing:1px;color:#111">Grace<span style="color:#0078ff">Flow</span></div>'
    +'<div style="font-size:15px;color:#555;margin-top:5px">Absent Members Report</div>'
    +'</div>'

    // Meta info
    +'<div style="display:flex;justify-content:space-between;font-size:12px;color:#777;margin-bottom:16px;flex-wrap:wrap;gap:6px">'
    +'<span><strong>Service:</strong> '+service+'</span>'
    +'<span><strong>Date:</strong> '+fmtDate(date)+'</span>'
    +'<span><strong>Printed:</strong> '+new Date().toLocaleString()+'</span>'
    +'</div>'

    // Summary stats
    +'<div style="display:flex;gap:20px;background:#f0f6ff;padding:14px 20px;border-left:5px solid #0078ff;margin-bottom:24px;flex-wrap:wrap;border-radius:4px">'
    +'<div style="text-align:center;min-width:55px"><div style="font-size:28px;font-weight:900;color:#111">'+members.length+'</div><div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#888">Total</div></div>'
    +'<div style="text-align:center;min-width:55px"><div style="font-size:28px;font-weight:900;color:#2e7d32">'+present.length+'</div><div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#888">Present</div></div>'
    +'<div style="text-align:center;min-width:55px"><div style="font-size:28px;font-weight:900;color:#c62828">'+absent.length+'</div><div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#888">Absent</div></div>'
    +'<div style="text-align:center;min-width:55px"><div style="font-size:28px;font-weight:900;color:#0078ff">'+rate+'%</div><div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#888">Rate</div></div>'
    +'</div>'

    // Absent table
    +'<div style="font-size:12px;text-transform:uppercase;letter-spacing:1.5px;color:#c62828;font-weight:700;margin-bottom:10px">Absent Members ('+absent.length+')</div>'
    +'<table style="width:100%;border-collapse:collapse;margin-bottom:28px">'
    +'<thead><tr style="background:#0078ff">'
    +'<th style="padding:10px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#fff;font-weight:600">#</th>'
    +'<th style="padding:10px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#fff;font-weight:600">Name</th>'
    +'<th style="padding:10px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#fff;font-weight:600">Family</th>'
    +'<th style="padding:10px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#fff;font-weight:600">Phone</th>'
    +'<th style="padding:10px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#fff;font-weight:600">Status</th>'
    +'</tr></thead>'
    +'<tbody>'+absentRows+'</tbody>'
    +'</table>'

    // Footer
    +'<div style="text-align:center;font-size:11px;color:#aaa;border-top:1px solid #eee;padding-top:14px;margin-top:10px">'
    +'Generated by CACI O6 Assembly Church Management &middot; '+new Date().getFullYear()
    +'</div>';

  // Inject into on-page modal and open it
  var contentEl = document.getElementById('print-report-content');
  if(contentEl){
    contentEl.innerHTML = reportContent;
    openPrintModal();
  } else {
    showToast('Print panel not found. Please reload the app.','red');
  }
}
function inFilter(days){return bdayFilter==='all'||(bdayFilter==='today'&&days===0)||(bdayFilter==='week'&&days<=7)||(bdayFilter==='month'&&days<=30);}
function setBdayFilter(f,btn){bdayFilter=f;document.querySelectorAll('#bday-pills .tab-pill').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderBirthdays();}
function renderBirthdays(){
  const today=new Date();
  const bm=members.filter(m=>m.dob).map(m=>({m,days:daysUntil(m.dob.slice(5))})).filter(x=>inFilter(x.days)).sort((a,b)=>a.days-b.days);
  const av=members.filter(m=>m.joinDate).map(m=>{const days=daysUntil(m.joinDate.slice(5));const years=today.getFullYear()-parseInt(m.joinDate.slice(0,4));return{m,days,years};}).filter(x=>inFilter(x.days)&&x.years>0).sort((a,b)=>a.days-b.days);
  const todayB=members.filter(m=>m.dob&&daysUntil(m.dob.slice(5))===0).length;
  const weekB=members.filter(m=>m.dob&&daysUntil(m.dob.slice(5))<=7).length;
  const monthB=members.filter(m=>m.dob&&daysUntil(m.dob.slice(5))<=30).length;
  const todayA=members.filter(m=>m.joinDate&&daysUntil(m.joinDate.slice(5))===0).length;
  const bsEl=document.getElementById('bday-stats');
  if(bsEl)bsEl.innerHTML=[{l:'Today Birthdays',v:todayB,c:'#d4956a'},{l:'This Week',v:weekB,c:'#7eaa92'},{l:'This Month',v:monthB,c:'#8fa8d4'},{l:'Anniversaries Today',v:todayA,c:'#c47e8a'}].map(s=>`<div class="stat-card"><div class="stat-num" style="color:${s.c}">${s.v}</div><div class="stat-lbl">${s.l}</div></div>`).join('');
  const bl=document.getElementById('bday-list');
  if(bl)bl.innerHTML=bm.length?bm.map(({m,days})=>`<div class="reminder-card">${avHtml(m,34)}<div style="flex:1;min-width:0"><div style="font-family:'Playfair Display',serif;font-size:12px;font-weight:700;color:#f0e8d8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${m.firstName} ${m.lastName}</div><div style="font-size:10px;color:#5a4e42;margin-top:1px">${fmtShort(m.dob)}</div></div>${dayPill(days)}</div>`).join(''):'<div style="padding:18px;text-align:center;color:#4a3e42;font-size:12px">No birthdays in this period.</div>';
  const al=document.getElementById('anniv-list');
  if(al)al.innerHTML=av.length?av.map(({m,days,years})=>`<div class="reminder-card">${avHtml(m,34)}<div style="flex:1;min-width:0"><div style="font-family:'Playfair Display',serif;font-size:12px;font-weight:700;color:#f0e8d8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${m.firstName} ${m.lastName}</div><div style="font-size:10px;color:#5a4e42;margin-top:1px">${years}yr member · Joined ${fmtShort(m.joinDate)}</div></div>${dayPill(days)}</div>`).join(''):'<div style="padding:18px;text-align:center;color:#4a3e42;font-size:12px">No anniversaries in this period.</div>';
  // ── Gender Widget ──
  var gWid=document.getElementById('gender-widget');
  if(gWid){
    var male=members.filter(function(m){return m.gender==='Male';}).length;
    var female=members.filter(function(m){return m.gender==='Female';}).length;
    var other=members.filter(function(m){return m.gender&&m.gender!=='Male'&&m.gender!=='Female';}).length;
    var tot=members.length||1;
    if(!members.length){gWid.innerHTML='<div style="color:#4a3e42;font-size:12px;padding:6px">No members yet.</div>';}
    else{
      var mp=Math.round((male/tot)*100);
      var fp=Math.round((female/tot)*100);
      gWid.style.cursor='pointer';gWid.onclick=function(){goPage('members');};gWid.innerHTML='<div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;margin-bottom:4px"><span style="font-size:12px;color:#8fa8d4">Male</span><span style="font-size:12px;color:#8fa8d4;font-weight:700">'+male+'</span></div><div style="background:rgba(255,255,255,.07);border-radius:20px;height:8px;overflow:hidden"><div style="width:'+mp+'%;height:100%;background:linear-gradient(90deg,#0078ff,#00c8ff);border-radius:20px"></div></div></div><div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;margin-bottom:4px"><span style="font-size:12px;color:#c47e8a">Female</span><span style="font-size:12px;color:#c47e8a;font-weight:700">'+female+'</span></div><div style="background:rgba(255,255,255,.07);border-radius:20px;height:8px;overflow:hidden"><div style="width:'+fp+'%;height:100%;background:linear-gradient(90deg,#c47e8a,#e0a0b0);border-radius:20px"></div></div></div><div style="display:flex;justify-content:space-around;margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,.06)"><div style="text-align:center"><div style="font-size:18px;font-weight:700;color:#8fa8d4">'+mp+'%</div><div style="font-size:10px;color:#4a3e42">Male</div></div><div style="text-align:center"><div style="font-size:18px;font-weight:700;color:#c47e8a">'+fp+'%</div><div style="font-size:10px;color:#4a3e42">Female</div></div></div>';
    }
  }
  // ── Day Borns Widget ──
  // Day Borns widget (bar chart)
  var dbWid=document.getElementById('dayborn-widget');
  var dayKeys=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  var dayIds=['sun','mon','tue','wed','thu','fri','sat'];
  var dc={Sunday:0,Monday:0,Tuesday:0,Wednesday:0,Thursday:0,Friday:0,Saturday:0};
  members.forEach(function(m){if(m.dob){var d=new Date(m.dob);if(!isNaN(d))dc[dayKeys[d.getDay()]]++;}});
  var maxD=Math.max.apply(null,Object.values(dc).concat([1]));
  var clrs={Sunday:'#d4956a',Monday:'#8fa8d4',Tuesday:'#7eaa92',Wednesday:'#c47e8a',Thursday:'#6aabee',Friday:'#f0c060',Saturday:'#9b8fd4'};
  if(dbWid){
    dbWid.style.cursor='pointer';dbWid.onclick=function(){goPage('members');};
    if(!members.length){dbWid.innerHTML='<div style="color:#4a3e42;font-size:12px;padding:6px">No members yet.</div>';}
    else{dbWid.innerHTML=dayKeys.map(function(day){return '<div style="display:flex;align-items:center;gap:8px;margin-bottom:7px"><div style="font-size:10px;color:#5a4e42;width:30px">'+day.slice(0,3)+'</div><div style="flex:1;background:rgba(255,255,255,.07);border-radius:20px;height:7px;overflow:hidden"><div style="width:'+Math.round((dc[day]/maxD)*100)+'%;height:100%;background:'+clrs[day]+';border-radius:20px"></div></div><div style="font-size:11px;font-weight:700;color:'+clrs[day]+';width:20px;text-align:right">'+dc[day]+'</div></div>';}).join('');}
  }
  // Update individual day cards
  dayKeys.forEach(function(day,i){
    var el=document.getElementById('day-'+dayIds[i]);
    if(el) el.textContent=dc[day];
  });
  // Update ministry counts
  var minMap = {'Youth':'min-youth','Young Ladies':'min-youngladies','Men Fellowship':'min-men','Good Women Fellowship':'min-goodwomen'};
  Object.keys(minMap).forEach(function(min){
    var el = document.getElementById(minMap[min]);
    if(el) el.textContent = members.filter(function(m){ return m.ministry === min; }).length;
  });
  const nb=document.getElementById('bday-nav-badge');if(nb){const n=members.filter(m=>m.dob&&daysUntil(m.dob.slice(5))<=7).length;nb.textContent=n;nb.style.display=n>0?'inline':'none';}
}

// ════════ VISITORS ════════
function openVisitorForm(visitor){
  editingVid=visitor?visitor.id:null;
  const gi=id=>document.getElementById(id);
  gi('vf-first').value=visitor?visitor.firstName:'';gi('vf-last').value=visitor?visitor.lastName:'';
  gi('vf-phone').value=visitor?visitor.phone:'';gi('vf-date').value=visitor?visitor.date:todayStr();
  gi('vf-service').value=visitor?visitor.service:'Sunday Morning Service';gi('vf-status').value=visitor?visitor.status:'New';
  gi('vf-invited').value=visitor?visitor.invitedBy:'';gi('vf-notes').value=visitor?visitor.notes:'';
  gi('ve-first').textContent='';gi('ve-last').textContent='';
  gi('vis-form-title').textContent=visitor?'Edit Visitor':'Log New Visitor';
  gi('vis-submit-btn').textContent=visitor?'Save Changes':'Log Visitor';
  document.getElementById('vis-modal').classList.add('open');
}
function closeVisModal(){document.getElementById('vis-modal').classList.remove('open');editingVid=null;}
function submitVisitor(){
  if(!canEdit()){showToast('Permission denied. You do not have access to log or edit visitors.','red');return;}
  const gi=id=>document.getElementById(id);
  const first=gi('vf-first').value.trim(),last=gi('vf-last').value.trim();
  gi('ve-first').textContent='';gi('ve-last').textContent='';gi('vf-first').classList.remove('err');gi('vf-last').classList.remove('err');
  let ok=true;if(!first){gi('ve-first').textContent='Required';gi('vf-first').classList.add('err');ok=false;}if(!last){gi('ve-last').textContent='Required';gi('vf-last').classList.add('err');ok=false;}if(!ok)return;
  const data={firstName:first,lastName:last,phone:gi('vf-phone').value.trim(),date:gi('vf-date').value,service:gi('vf-service').value,status:gi('vf-status').value,invitedBy:gi('vf-invited').value.trim(),notes:gi('vf-notes').value.trim()};
  if(editingVid!==null){visitors=visitors.map(v=>v.id===editingVid?{...data,id:editingVid}:v);const updV=visitors.find(v=>v.id===editingVid);if(updV)sbUpsertVisitor(updV);showToast(`${first} ${last} updated.`);}
  else{data.id=genVid();visitors=[data,...visitors];addAct('#8fa8d4',`Visitor: ${first} ${last}`,'#8fa8d4');sbUpsertVisitor(data);showToast(`${first} ${last} logged as visitor!`);}
  closeVisModal();saveData();renderVisitors();
}
function renderVisitors(){
  // Role-based visitor header button
  const vhb=document.getElementById('vis-hdr-btn');
  if(vhb) vhb.innerHTML=canEdit()?'<button class="btn-gold" onclick="openVisitorForm()">+ Log Visitor</button>':'<span style="font-size:11px;color:#7c6fcd;background:rgba(139,92,246,.08);border:1px solid rgba(139,92,246,.2);padding:8px 14px;border-radius:8px;display:inline-block">🔒 View-only access</span>';
  const q=(document.getElementById('vis-search').value||'').toLowerCase();
  const fs=(document.getElementById('vis-filter')||{}).value||'';
  const filtered=visitors.filter(v=>`${v.firstName} ${v.lastName} ${v.phone} ${v.invitedBy||''}`.toLowerCase().includes(q)&&(!fs||v.status===fs));
  const vsEl=document.getElementById('vis-stats');
  if(vsEl)vsEl.innerHTML=[{l:'Total',v:visitors.length,c:'#f0e8d8'},{l:'New',v:visitors.filter(v=>v.status==='New').length,c:'#7eaa92'},{l:'Contacted',v:visitors.filter(v=>v.status==='Contacted').length,c:'#d4956a'},{l:'Returning',v:visitors.filter(v=>v.status==='Returning').length,c:'#8fa8d4'}].map(s=>`<div class="stat-card"><div class="stat-num" style="color:${s.c}">${s.v}</div><div class="stat-lbl">${s.l}</div></div>`).join('');
  const el=document.getElementById('vis-list'),emEl=document.getElementById('vis-empty');
  if(!visitors.length){if(el)el.innerHTML='';if(emEl)emEl.style.display='block';return;}if(emEl)emEl.style.display='none';
  if(!filtered.length){if(el)el.innerHTML='<div class="empty-state" style="padding:36px"><h3 style="font-size:16px;color:#6a5e52">No visitors found</h3></div>';return;}
  const sCls=s=>({New:'vfb-new',Contacted:'vfb-contacted',Returning:'vfb-returning'}[s]||'vfb-new');
  const dotC=s=>({New:'#7eaa92',Contacted:'#d4956a',Returning:'#8fa8d4'}[s]||'#7eaa92');
  if(el)el.innerHTML=filtered.map(v=>`<div class="visitor-row" onclick="openVisDetail(${v.id})"><div style="width:6px;height:6px;border-radius:50%;background:${dotC(v.status)};flex-shrink:0"></div><div style="width:36px;height:36px;border-radius:50%;background:rgba(143,168,212,.15);border:1px solid rgba(143,168,212,.3);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0">🙋</div><div style="flex:1;min-width:0"><div style="font-family:'Playfair Display',serif;font-size:13px;font-weight:700;color:#f0e8d8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${v.firstName} ${v.lastName}</div><div style="font-size:10px;color:#5a4e42;margin-top:1px">${v.service} · ${fmtShort(v.date)}</div>${v.invitedBy?`<div style="font-size:9px;color:#4a3e42;margin-top:1px">Invited by: ${v.invitedBy}</div>`:''}</div><div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px"><span class="vfb ${sCls(v.status)}">${v.status}</span>${v.phone?`<span style="font-size:9px;color:#4a3e42">${v.phone}</span>`:''}</div></div>`).join('');
}
function openVisDetail(id){
  detailVid=id;confirmDelVis=false;
  const v=visitors.find(x=>x.id===id);if(!v)return;
  const sCls=s=>({New:'vfb-new',Contacted:'vfb-contacted',Returning:'vfb-returning'}[s]||'vfb-new');
  document.getElementById('vd-name').textContent=`${v.firstName} ${v.lastName}`;
  document.getElementById('vd-status-badge').innerHTML=`<span class="vfb ${sCls(v.status)}">${v.status}</span>`;
  document.getElementById('vd-details').innerHTML=[['Date of Visit',fmtDate(v.date)],['Phone',v.phone||'—'],['Service',v.service],['Invited By',v.invitedBy||'—'],['Status',v.status]].map(([k,val])=>`<div><div class="detail-key">${k}</div><div class="detail-val">${val}</div></div>`).join('');
  document.getElementById('vd-notes').innerHTML=v.notes?`<div class="modal-notes">${v.notes}</div>`:'';
  renderVDActions();document.getElementById('vis-detail-modal').classList.add('open');
}
function renderVDActions(){
  const el=document.getElementById('vd-actions');const v=visitors.find(x=>x.id===detailVid);if(!v||!el)return;
  if(confirmDelVis){
    el.innerHTML=`<span style="font-size:12px;color:#5a4e42;align-self:center">Remove visitor?</span><button class="btn-dark" style="padding:7px 12px" onclick="confirmDelVis=false;renderVDActions()">Cancel</button><button class="btn-red" onclick="deleteVisitor(${detailVid})">Yes, Remove</button>`;
  } else {
    const statusBtns=canEdit()?['New','Contacted','Returning'].filter(s=>s!==v.status).map(s=>`<button onclick="updateVisitorStatus(${detailVid},'${s}')" style="background:rgba(255,255,255,.05);color:#8a7a6a;border:1px solid rgba(255,255,255,.1);padding:6px 11px;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:10px;cursor:pointer">→ ${s}</button>`).join(''):'';
    const editBtn=canEdit()?`<button class="btn-gold" style="padding:7px 14px" onclick="closeVisDetail();openVisitorForm(visitors.find(x=>x.id===${detailVid}))">✎ Edit</button>`:`<span style="font-size:11px;color:#5a4e42;padding:4px 8px;background:rgba(255,255,255,.04);border-radius:6px;border:1px solid rgba(255,255,255,.08)">🔒 View Only</span>`;
    const delBtn=canDelete()?`<button class="btn-red" onclick="confirmDelVis=true;renderVDActions()">🗑 Remove</button>`:'';
    el.innerHTML=`${statusBtns}${delBtn}${editBtn}`;
  }
}
function updateVisitorStatus(id,ns){visitors=visitors.map(v=>v.id===id?{...v,status:ns}:v);const updV=visitors.find(v=>v.id===id);if(updV)sbUpsertVisitor(updV);saveData();showToast(`Status updated to ${ns}.`);closeVisDetail();renderVisitors();}
function deleteVisitor(id){if(!canDelete()){showToast('Permission denied. Only Administrators can delete records.','red');return;}visitors=visitors.filter(v=>v.id!==id);closeVisDetail();sbDeleteVisitor(id);saveData();showToast('Visitor removed.');renderVisitors();}
function closeVisDetail(){document.getElementById('vis-detail-modal').classList.remove('open');detailVid=null;confirmDelVis=false;}

// ════════ SMS ════════
function saveSmsConfig(){
  const token=(document.getElementById('sms-api-token')||{}).value||'';
  const secret=(document.getElementById('sms-api-secret')||{}).value||'';
  const el=document.getElementById('sms-api-status');if(!el)return;
  if(token&&secret){el.textContent='Configured ✓';el.className='badge badge-green';}
  else{el.textContent='Not Configured';el.className='badge badge-gold';}
}
function showSmsTab(tab){
  ['compose','templates','log'].forEach(t=>{
    const el=document.getElementById('sms-'+t);if(el)el.style.display=t===tab?'block':'none';
    const tb=document.getElementById('sms-tab-'+t);if(tb)tb.classList.toggle('active',t===tab);
  });
  if(tab==='templates')renderSmsTemplates();
  if(tab==='log')renderSmsLog();
}
function selectSmsGroup(group){
  smsSelected=new Set();
  if(group==='all')members.filter(m=>m.status==='Active').forEach(m=>smsSelected.add(m.id));
  else if(group==='absent')members.filter(m=>getAtt(m.id)==='absent').forEach(m=>smsSelected.add(m.id));
  else if(group==='birthday')members.filter(m=>m.dob&&daysUntil(m.dob.slice(5))<=7).forEach(m=>smsSelected.add(m.id));
  else if(group==='elders')members.filter(m=>['Elder','Deacon'].includes(m.memberType)).forEach(m=>smsSelected.add(m.id));
  renderSmsMembers();updateSmsCount();
}
function toggleSmsMember(id){if(smsSelected.has(id))smsSelected.delete(id);else smsSelected.add(id);renderSmsMembers();updateSmsCount();}
function renderSmsMembers(){
  const q=((document.getElementById('sms-member-search')||{}).value||'').toLowerCase();
  const filtered=members.filter(m=>`${m.firstName} ${m.lastName}`.toLowerCase().includes(q));
  const el=document.getElementById('sms-member-list');if(!el)return;
  el.innerHTML=filtered.map(m=>{const sel=smsSelected.has(m.id);return`<div onclick="toggleSmsMember(${m.id})" style="display:flex;align-items:center;gap:8px;padding:6px 9px;border-radius:7px;cursor:pointer;background:${sel?'rgba(74,144,217,.1)':'rgba(255,255,255,.03)'};border:1px solid ${sel?'rgba(74,144,217,.35)':'rgba(255,255,255,.06)'};transition:all .15s"><div style="width:14px;height:14px;border-radius:3px;border:1px solid ${sel?'#6aabee':'rgba(255,255,255,.2)'};background:${sel?'#4a90d9':'transparent'};display:flex;align-items:center;justify-content:center;font-size:9px;flex-shrink:0">${sel?'✓':''}</div>${avHtml(m,24)}<div style="flex:1;min-width:0"><div style="font-size:11px;color:#c0a888;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${m.firstName} ${m.lastName}</div><div style="font-size:9px;color:#4a3e42">${m.phone}</div></div></div>`;}).join('');
}
function updateSmsCount(){
  const rcEl=document.getElementById('sms-recip-count');if(rcEl)rcEl.textContent=`${smsSelected.size} selected`;
  const scEl=document.getElementById('sms-send-count');if(scEl)scEl.textContent=smsSelected.size;
  const sel=members.filter(m=>smsSelected.has(m.id));
  const chipsEl=document.getElementById('sms-chips');if(chipsEl)chipsEl.innerHTML=sel.slice(0,5).map(m=>`<span class="sms-chip">${m.firstName} ${m.lastName.charAt(0)}.</span>`).join('')+(sel.length>5?`<span class="sms-chip">+${sel.length-5} more</span>`:'');
}
function updateCharCount(){
  const msg=(document.getElementById('sms-msg')||{}).value||'';
  const cEl=document.getElementById('sms-chars');if(cEl)cEl.textContent=msg.length;
  const pEl=document.getElementById('sms-pages');if(pEl)pEl.textContent=Math.ceil(msg.length/160)||1;
}
function renderSmsTemplates(){
  const el=document.getElementById('sms-tpl-list');if(!el)return;
  el.innerHTML=SMS_TEMPLATES.map(t=>`<div class="sms-tpl-card" onclick="useTemplate(${t.id})"><div style="display:flex;align-items:center;gap:9px;margin-bottom:7px"><span style="font-size:18px">${t.icon}</span><div style="font-family:'Playfair Display',serif;font-size:13px;font-weight:700;color:#f0e8d8">${t.name}</div></div><div style="font-size:11px;color:#6a5e52;line-height:1.5">${t.msg.substring(0,90)}…</div><div style="margin-top:8px;font-size:10px;color:#4a90d9">Click to use →</div></div>`).join('');
}
function useTemplate(id){
  const t=SMS_TEMPLATES.find(x=>x.id===id);if(!t)return;
  showSmsTab('compose');
  const msgEl=document.getElementById('sms-msg');if(msgEl){msgEl.value=t.msg;updateCharCount();}
  showToast('Template loaded. Edit as needed.');
}
function renderSmsLog(){
  const lcEl=document.getElementById('log-count');if(lcEl)lcEl.textContent=`${smsLog.length} sent`;
  const el=document.getElementById('sms-log-body');if(!el)return;
  if(!smsLog.length){el.innerHTML='<div class="empty-state" style="padding:32px"><div class="empty-icon">📱</div><p style="font-size:12px">No messages sent yet.</p></div>';return;}
  el.innerHTML=smsLog.map(l=>`<div class="sms-log-row"><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:3px"><div style="font-family:'Playfair Display',serif;font-size:12px;font-weight:700;color:#f0e8d8">${l.label}</div><div style="font-size:10px;color:#4a3e42">${l.time}</div></div><div style="font-size:11px;color:#6a5e52;margin-bottom:3px">${l.msg.substring(0,70)}${l.msg.length>70?'…':''}</div><div style="display:flex;gap:6px"><span class="badge badge-blue">${l.count} recipients</span><span class="badge ${l.status==='Sent'||l.status.includes('Simulated')?'badge-green':'badge-red'}">${l.status}</span></div></div>`).join('');
}
function previewSms(){
  const msgEl=document.getElementById('sms-msg');const msg=msgEl?msgEl.value.trim():'';
  if(!msg){showToast('Please type a message first.','red');return;}
  if(!smsSelected.size){showToast('Please select at least one recipient.','red');return;}
  const pmEl=document.getElementById('preview-msg');if(pmEl)pmEl.textContent=msg;
  const sel=members.filter(m=>smsSelected.has(m.id));
  const prEl=document.getElementById('preview-recips');if(prEl)prEl.innerHTML=`<div style="font-size:11px;color:#5a4e42;margin-bottom:5px">Sending to ${sel.length} recipient${sel.length>1?'s':''}:</div><div style="display:flex;flex-wrap:wrap;gap:3px">${sel.slice(0,7).map(m=>`<span class="sms-chip">${m.firstName} ${m.lastName}</span>`).join('')}${sel.length>7?`<span class="sms-chip">+${sel.length-7} more</span>`:''}</div>`;
  const pages=Math.ceil(msg.length/160)||1;
  const pcEl=document.getElementById('preview-cost');if(pcEl)pcEl.textContent=`📊 ${sel.length} recipient${sel.length>1?'s':''} × ${pages} SMS page${pages>1?'s':''} = ${sel.length*pages} SMS credits`;
  document.getElementById('sms-preview-modal').classList.add('open');
}
async function sendSms(){
  const msgEl=document.getElementById('sms-msg');const msg=msgEl?msgEl.value.trim():'';
  if(!msg){showToast('Please type a message.','red');return;}
  if(!smsSelected.size){showToast('Select at least one recipient.','red');return;}
  const token=(document.getElementById('sms-api-token')||{}).value||'';
  const secret=(document.getElementById('sms-api-secret')||{}).value||'';
  const sender=(document.getElementById('sms-sender')||{}).value||'CACI O6 Assembly';
  const sel=members.filter(m=>smsSelected.has(m.id));
  const btn=document.getElementById('sms-send-btn');if(btn){btn.innerHTML='<span class="spinner"></span> Sending…';btn.disabled=true;}
  if(!token||!secret){
    await new Promise(r=>setTimeout(r,1200));
    const simEntry={label:`To ${sel.length} member${sel.length>1?'s':''}`,msg,count:sel.length,time:new Date().toLocaleString(),status:'Simulated (No API Key)'};smsLog.unshift(simEntry);sbInsertSmsLog(simEntry);saveData();
    addAct('#6aabee',`SMS simulated to ${sel.length} member${sel.length>1?'s':''}`,'#6aabee');
    showToast(`SMS simulated — add BulkSMS API credentials to send real messages.`);
    if(btn){btn.innerHTML='📱 Send SMS';btn.disabled=false;}
    if(msgEl)msgEl.value='';smsSelected=new Set();renderSmsMembers();updateSmsCount();renderSmsLog();return;
  }
  const recipients=sel.map(m=>({id:m.id.toString(),address:'+'+m.phone.replace(/\D/g,'')}));
  try{
    const resp=await fetch('https://api.bulksms.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Basic '+btoa(token+':'+secret)},body:JSON.stringify({to:recipients,body:msg,from:sender,routingGroup:'STANDARD'})});
    if(resp.ok){
      const sentEntry={label:`To ${sel.length} member${sel.length>1?'s':''}`,msg,count:sel.length,time:new Date().toLocaleString(),status:'Sent'};smsLog.unshift(sentEntry);sbInsertSmsLog(sentEntry);saveData();
      addAct('#6aabee',`SMS sent to ${sel.length} member${sel.length>1?'s':''}`,'#6aabee');
      showToast(`SMS sent to ${sel.length} recipient${sel.length>1?'s':''}!`);
      if(msgEl)msgEl.value='';smsSelected=new Set();renderSmsMembers();updateSmsCount();
    } else {
      try{const err=await resp.json();showToast(`SMS failed: ${err.detail||resp.status}`,'red');}catch{showToast(`SMS failed: ${resp.status}`,'red');}
      smsLog.unshift({label:`Failed — ${sel.length} recipients`,msg,count:sel.length,time:new Date().toLocaleString(),status:'Failed'});saveData();
    }
  } catch{showToast('Network error. Check API credentials.','red');smsLog.unshift({label:`Error — ${sel.length} recipients`,msg,count:sel.length,time:new Date().toLocaleString(),status:'Failed'});}
  if(btn){btn.innerHTML='📱 Send SMS';btn.disabled=false;}renderSmsLog();
}
function smsAbsent(){
  const absent=members.filter(m=>getAtt(m.id)==='absent');
  if(!absent.length){showToast('No absent members to SMS.','red');return;}
  absent.forEach(m=>smsSelected.add(m.id));
  const t=SMS_TEMPLATES.find(x=>x.id===3);
  goPage('sms');
  setTimeout(()=>{if(t){const msgEl=document.getElementById('sms-msg');if(msgEl){msgEl.value=t.msg;updateCharCount();}}renderSmsMembers();updateSmsCount();showToast(`${absent.length} absent member${absent.length>1?'s':''} selected for SMS.`);},200);
}
function smsSingleMember(id){
  smsSelected=new Set([id]);goPage('sms');
  setTimeout(()=>{renderSmsMembers();updateSmsCount();showToast('Member selected. Type your message and send.');},200);
}
function sendBirthdaySMS(){
  const bday=members.filter(m=>m.dob&&daysUntil(m.dob.slice(5))<=7);
  if(!bday.length){showToast('No birthdays this week.','red');return;}
  bday.forEach(m=>smsSelected.add(m.id));
  const t=SMS_TEMPLATES.find(x=>x.id===4);
  goPage('sms');
  setTimeout(()=>{if(t){const msgEl=document.getElementById('sms-msg');if(msgEl){msgEl.value=t.msg;updateCharCount();}}renderSmsMembers();updateSmsCount();showToast(`${bday.length} birthday member${bday.length>1?'s':''} selected!`);},200);
}


// ════════ CSV EXPORT ════════
function escCSV(val){
  if(val===null||val===undefined) return '';
  var s=String(val).replace(/"/g,'""');
  return /[,"\n\r]/.test(s)?'"'+s+'"':s;
}
function rowCSV(arr){ return arr.map(escCSV).join(',')+"\r\n"; }

function downloadCSV(filename, csvStr){
  try{
    // Method 1: Blob URL (works on hosted sites)
    var blob=new Blob(['\uFEFF'+csvStr],{type:'text/csv;charset=utf-8'});
    var url=URL.createObjectURL(blob);
    var a=document.createElement('a');
    a.href=url;a.download=filename;a.style.display='none';
    document.body.appendChild(a);a.click();
    setTimeout(function(){document.body.removeChild(a);URL.revokeObjectURL(url);},300);
  }catch(e){
    try{
      // Method 2: Data URI (works on local file:// and most browsers)
      var encoded=encodeURIComponent('\uFEFF'+csvStr);
      var a2=document.createElement('a');
      a2.href='data:text/csv;charset=utf-8,'+encoded;
      a2.download=filename;a2.style.display='none';
      document.body.appendChild(a2);a2.click();
      setTimeout(function(){document.body.removeChild(a2);},300);
    }catch(e2){
      // Method 3: Open in new tab so user can save manually
      var w=window.open('','_blank');
      if(w){
        w.document.write('<pre style="font-family:monospace;font-size:12px;white-space:pre-wrap">'+csvStr+'</pre>');
        w.document.title=filename;
        w.document.close();
        showExportStatus('File opened in new tab — press Ctrl+S (or Cmd+S) to save as '+filename);
      } else {
        showExportStatus('Download blocked. Please allow popups for this page and try again.',false);
      }
    }
  }
}

function showExportStatus(msg,ok){
  if(ok===undefined)ok=true;
  var el=document.getElementById('export-status');
  if(!el)return;
  el.style.display='block';
  el.style.background=ok?'rgba(16,185,129,.1)':'rgba(239,68,68,.1)';
  el.style.border=ok?'1px solid rgba(16,185,129,.25)':'1px solid rgba(239,68,68,.25)';
  el.style.color=ok?'#34d399':'#f87171';
  el.textContent=(ok?'✓ ':'✗ ')+msg;
  setTimeout(function(){el.style.display='none';},4000);
}

function exportCSV(type){
  var date=new Date().toISOString().slice(0,10);
  var csv='',filename='';

  if(type==='members'){
    if(!members.length){showExportStatus('No members to export.',false);return;}
    filename='graceflow-members-'+date+'.csv';
    csv+=rowCSV(['ID','First Name','Last Name','Gender','Date of Birth','Phone','Address',
                 'Location','Position','Member Type','Status','Family Group','Join Date','Notes']);
    members.forEach(function(m){
      csv+=rowCSV([m.id,m.firstName,m.lastName,m.gender||'',m.dob||'',m.phone,
                   m.address||'',m.location||'',m.position||'',m.memberType,
                   m.status,m.family||'',m.joinDate||'',m.notes||'']);
    });
    showExportStatus(members.length+' members exported to '+filename);
  }
  else if(type==='visitors'){
    if(!visitors.length){showExportStatus('No visitors to export.',false);return;}
    filename='graceflow-visitors-'+date+'.csv';
    csv+=rowCSV(['ID','First Name','Last Name','Phone','Date of Visit','Service',
                 'Invited By','Follow-up Status','Notes']);
    visitors.forEach(function(v){
      csv+=rowCSV([v.id,v.firstName,v.lastName,v.phone||'',v.date||'',
                   v.service||'',v.invitedBy||'',v.status||'',v.notes||'']);
    });
    showExportStatus(visitors.length+' visitors exported to '+filename);
  }
  else if(type==='attendance'){
    var keys=Object.keys(attData);
    if(!keys.length){showExportStatus('No attendance records to export.',false);return;}
    filename='graceflow-attendance-'+date+'.csv';
    csv+=rowCSV(['Date','Service','Member ID','Member Name','Attendance Status']);
    keys.forEach(function(k){
      var parts=k.split('__');
      var sessDate=parts[0]||'',service=parts[1]||'';
      var sessData=attData[k]||{};
      Object.keys(sessData).forEach(function(memberId){
        var status=sessData[memberId];
        var m=members.find(function(x){return x.id==memberId;});
        var name=m?(m.firstName+' '+m.lastName):'Member #'+memberId;
        csv+=rowCSV([sessDate,service,memberId,name,status||'unmarked']);
      });
    });
    var rowCount=keys.reduce(function(acc,k){return acc+Object.keys(attData[k]||{}).length;},0);
    showExportStatus(rowCount+' attendance records exported to '+filename);
  }
  else if(type==='smslog'){
    if(!smsLog.length){showExportStatus('No SMS log entries to export.',false);return;}
    filename='graceflow-smslog-'+date+'.csv';
    csv+=rowCSV(['Time Sent','Label','Recipient Count','Message','Status']);
    smsLog.forEach(function(l){
      csv+=rowCSV([l.time||'',l.label||'',l.count||0,l.msg||'',l.status||'']);
    });
    showExportStatus(smsLog.length+' SMS entries exported to '+filename);
  }

  if(csv && filename) downloadCSV(filename,csv);
}

function exportAllCSV(){
  var date=new Date().toISOString().slice(0,10);
  var exported=0;

  if(members.length){
    var csv=rowCSV(['ID','First Name','Last Name','Gender','Date of Birth','Phone','Address',
                    'Location','Position','Member Type','Status','Family Group','Join Date','Notes']);
    members.forEach(function(m){
      csv+=rowCSV([m.id,m.firstName,m.lastName,m.gender||'',m.dob||'',m.phone,
                   m.address||'',m.location||'',m.position||'',m.memberType,
                   m.status,m.family||'',m.joinDate||'',m.notes||'']);
    });
    downloadCSV('graceflow-members-'+date+'.csv',csv);
    exported++;
  }

  if(visitors.length){
    var csv2=rowCSV(['ID','First Name','Last Name','Phone','Date of Visit','Service',
                     'Invited By','Follow-up Status','Notes']);
    visitors.forEach(function(v){
      csv2+=rowCSV([v.id,v.firstName,v.lastName,v.phone||'',v.date||'',
                    v.service||'',v.invitedBy||'',v.status||'',v.notes||'']);
    });
    downloadCSV('graceflow-visitors-'+date+'.csv',csv2);
    exported++;
  }

  var attKeys=Object.keys(attData);
  if(attKeys.length){
    var csv3=rowCSV(['Date','Service','Member ID','Member Name','Attendance Status']);
    attKeys.forEach(function(k){
      var parts=k.split('__');
      var sessDate=parts[0]||'',service=parts[1]||'';
      Object.keys(attData[k]||{}).forEach(function(memberId){
        var status=attData[k][memberId];
        var m=members.find(function(x){return x.id==memberId;});
        var name=m?(m.firstName+' '+m.lastName):'Member #'+memberId;
        csv3+=rowCSV([sessDate,service,memberId,name,status||'unmarked']);
      });
    });
    downloadCSV('graceflow-attendance-'+date+'.csv',csv3);
    exported++;
  }

  if(!exported){
    showExportStatus('No data found. Register members first.',false);
  } else {
    showExportStatus(exported+' CSV file'+(exported>1?'s':'')+' downloaded — check your Downloads folder.');
  }
}


// ════════ PRINT MODAL ════════
function openPrintModal(){
  document.getElementById('print-modal-overlay').style.display='block';
  document.body.style.overflow='hidden';
}
function closePrintModal(){
  document.getElementById('print-modal-overlay').style.display='none';
  document.body.style.overflow='';
}
function triggerPrint(){
  window.print();
}

// ════════ INIT ════════
window.addEventListener('DOMContentLoaded',function(){
  loadData();
  loadSmsConfig();
  loadSbConfig();
  initSupabase();
  if(supabaseConnected){pullFromSupabase().then(()=>{renderDashboard();}).catch(e=>console.warn(e));}
  const attDate=document.getElementById('att-date');if(attDate)attDate.value=todayStr();
  ['mem-modal','vis-modal','vis-detail-modal','sms-preview-modal'].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.addEventListener('click',function(e){if(e.target===this)this.classList.remove('open');});
  });
  const locInp = document.getElementById('f-location');
  if(locInp) locInp.addEventListener('input', updateLocationPreview);
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape')document.querySelectorAll('.overlay.open').forEach(o=>o.classList.remove('open'));
  });
});
</script>

<!-- ══ PRINT REPORT MODAL ══ -->
<style>
@media print {
  body > *:not(#print-modal-overlay) { display: none !important; }
  #print-modal-overlay { display: block !important; background: #fff !important; padding: 0 !important; position:static !important; }
  #print-controls { display: none !important; }
  #print-report-content { border-radius: 0 !important; padding: 20px !important; box-shadow: none !important; }
}
</style>
<div id="print-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(2,12,27,.97);z-index:9000;overflow-y:auto;padding:0">
  <div style="max-width:760px;margin:0 auto;padding:20px">
    <div id="print-controls" style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 0 18px;flex-wrap:wrap">
      <div style="font-size:18px;color:#cfe4ff;font-weight:700;font-family:'Playfair Display',serif">📄 Absent Members Report</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button onclick="triggerPrint()" style="background:linear-gradient(135deg,#0078ff,#00aaff);color:#fff;border:none;border-radius:8px;padding:10px 24px;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 4px 14px rgba(0,140,255,.4)">🖨 Print Now</button>
        <button onclick="closePrintModal()" style="background:rgba(255,255,255,.06);color:#6a90b0;border:1px solid rgba(0,140,255,.2);border-radius:8px;padding:10px 18px;font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer">✕ Close</button>
      </div>
    </div>
    <div id="print-report-content" style="background:#fff;color:#111;border-radius:12px;padding:44px;font-family:Arial,sans-serif;line-height:1.5;box-shadow:0 20px 60px rgba(0,0,0,.5)"></div>
  </div>
</div>
</body>
</html>
